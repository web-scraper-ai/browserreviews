          </div>
          <div class="spec-item">
            <span class="spec-label">Stealth Engine</span>
            <span class="spec-val">Residential IP Rotation</span>
          </div>
        </div>
        <div class="spotlight-actions">
          <a href={`/mcp/${featuredMcp.slug}`} class="btn btn-primary">View Setup Guide</a>
          <a href={featuredMcp.website_url} target="_blank" rel="noopener noreferrer" class="btn btn-outline">Official Portal ↗</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Cross-Link Banner to 40+ Scraping Targets -->
  <section class="targets-banner-section">
    <div class="container">
      <div class="targets-card">
        <div class="targets-info">
          <span class="badge-mini" style="background: rgba(245, 158, 11, 0.15); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.3);">📦 40+ TESTED SCRAPING TARGETS</span>
          <h3 class="targets-title">Need Production Scraping Scripts for Cloud Browsers?</h3>
          <p class="targets-text">
            Explore our companion repository at <strong>ScrapingReview.com/targets</strong> featuring 40+ tested Playwright templates for Amazon, TikTok, Cloudflare, LinkedIn, Walmart, and YouTube with native 2Captcha CDP integration.
          </p>
        </div>
        <div class="targets-cta">
          <a href="https://scrapingreview.com/targets" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            Browse 40+ Scraping Targets ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Top 10 Cloud Browsers Leaderboard -->
  <section class="section-container">
    <div class="section-header">
      <div>
        <h2 class="section-title">2026 Cloud Browser Leaderboard</h2>
        <p class="section-desc">Top 10 cloud browser APIs evaluated for anti-bot bypass, CDP WebSocket stability, and hourly pricing.</p>
      </div>
      <a href="/browsers" class="link-view-all">View All 60 Cloud Browsers →</a>
    </div>

    <div class="table-responsive">
      <table class="leaderboard-table">
        <thead>
          <tr>
            <th style="width: 60px;">Rank</th>
            <th>Cloud Browser Provider</th>
