            <div class="terminal-bar-bottom">
              <div class="terminal-note">
                💡 <strong>Auto-Bypass:</strong> Cloudflare Turnstile &amp; DataDome are solved automatically in the browser cluster.
              </div>
              <div class="terminal-actions">
                <button type="button" class="terminal-btn" id="btn-copy-cdp">📋 Copy Code</button>
                <button type="button" class="terminal-btn" id="btn-download-cdp">💾 Download .py</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Spend & Concurrency Calculator -->
  <section class="calc-section">
    <div class="container">
      <div class="section-header-centered">
        <span class="badge-mini">Raycast Cost Analysis</span>
        <h2 class="section-title">Cloud Browser Automation Spend Calculator</h2>
        <p class="section-subtitle">
          Calculate your monthly cloud browser runtime costs. Compare 2Captcha's $0.15/hr pay-as-you-go architecture against expensive monthly subscriptions and bandwidth fees.
