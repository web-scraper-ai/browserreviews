        <div class="calc-controls">
          <div class="calc-slider-group">
            <div class="slider-header">
              <span class="slider-label">Daily Scraping Hours:</span>
              <span class="slider-val tabular-nums" id="val-hours">4 hours / day</span>
            </div>
            <input type="range" id="slider-hours" min="1" max="24" value="4" class="ray-slider" />
          </div>

          <div class="calc-slider-group" style="margin-top: 20px;">
            <div class="slider-header">
              <span class="slider-label">Concurrent Browser Tabs:</span>
              <span class="slider-val tabular-nums" id="val-tabs">5 concurrent</span>
            </div>
            <input type="range" id="slider-tabs" min="1" max="20" value="5" class="ray-slider" />
          </div>
        </div>

        <div class="calc-comparison-grid">
          <!-- 2Captcha Browser Card -->
          <div class="calc-card winner-card">
            <div class="calc-badge">★ #1 RECOMMENDED</div>
