      const valTabs = document.getElementById('val-tabs');
      const price2cap = document.getElementById('price-2captcha');
      const priceBb = document.getElementById('price-browserbase');
      const valSavings = document.getElementById('val-savings');

      function updateCalc() {
        if (!sliderHours || !sliderTabs) return;
        const hours = parseInt(sliderHours.value, 10);
        const tabs = parseInt(sliderTabs.value, 10);

        if (valHours) valHours.textContent = `${hours} hours / day`;
        if (valTabs) valTabs.textContent = `${tabs} concurrent tab${tabs > 1 ? 's' : ''}`;

        // 30 days per month
        const totalBrowserHours = hours * tabs * 30;
