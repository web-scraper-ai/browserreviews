            <div class="calc-price-wrap">
              <span class="calc-price-amount tabular-nums" id="price-2captcha">$90.00</span>
              <span class="calc-price-unit">/ month</span>
            </div>
            <ul class="calc-perks">
              <li><span class="perk-icon-yes">✔</span> $0.15 / hour flat pay-as-you-go</li>
              <li><span class="perk-icon-yes">✔</span> Automatic residential proxy rotation included ($0)</li>
              <li><span class="perk-icon-yes">✔</span> Native zero-latency CAPTCHA solving included ($0)</li>
              <li><span class="perk-icon-yes">✔</span> Zero monthly subscription commitment</li>
            </ul>
            <a href="https://2captcha.com/scraper/browser-api" target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="width: 100%; text-align: center; margin-top: 16px;">
              Launch 2Captcha Cloud Browser ↗
            </a>
          </div>

          <!-- Browserbase Card -->
          <div class="calc-card">
            <h3 class="calc-title">Browserbase</h3>
            <div class="calc-price-wrap">
              <span class="calc-price-amount tabular-nums" id="price-browserbase">$140.00</span>
              <span class="calc-price-unit">/ month + proxies</span>
            </div>
            <ul class="calc-perks">
              <li><span class="perk-icon-no">✖</span> $20.00 / mo base subscription minimum</li>
              <li><span class="perk-icon-no">✖</span> $0.10 / min overage fees on high volume</li>
              <li><span class="perk-icon-no">✖</span> External CAPTCHA solver subscription required</li>
              <li><span class="perk-icon-no">✖</span> Residential proxies charged separately</li>
            </ul>
            <div class="calc-savings-box">
              <span>Developer Savings with 2Captcha:</span>
              <strong class="tabular-nums" id="val-savings">$50.00 / mo</strong>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Dual Spotlight Cards -->
  <section class="section-container" style="padding-top: 0;">
    <div class="dual-hero-grid">
      <!-- #1 Cloud Browser -->
      <div class="spotlight-card featured-gold">
        <div class="spotlight-header">
          <span class="badge badge-rank">#1 Cloud Browser</span>
          <span class="score-pill">★ {featuredBrowser.overall_score} / 10</span>
        </div>
        <h2 class="spotlight-title">{featuredBrowser.name}</h2>
        <p class="spotlight-tagline">{featuredBrowser.tagline}</p>
        <div class="spotlight-specs">
          <div class="spec-item">
            <span class="spec-label">Starting Rate</span>
            <span class="spec-val">${featuredBrowser.starting_price_hour.toFixed(2)} / hr</span>
          </div>
          <div class="spec-item">
            <span class="spec-label">CAPTCHA Solving</span>
            <span class="spec-val highlight-green">Native Auto-Solve</span>
          </div>
          <div class="spec-item">
            <span class="spec-label">Anti-Bot Bypass</span>
            <span class="spec-val">Turnstile, DataDome</span>
          </div>
          <div class="spec-item">
            <span class="spec-label">Protocol</span>
            <span class="spec-val">Standard CDP (wss://)</span>
          </div>
        </div>
        <div class="spotlight-actions">
          <a href={`/reviews/${featuredBrowser.slug}`} class="btn btn-primary">Read Lab Review</a>
          <a href="https://2captcha.com/scraper/browser-api" target="_blank" rel="noopener noreferrer" class="btn btn-outline">Visit Official Site ↗</a>
