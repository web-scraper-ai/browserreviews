---
import Base from "../layouts/Base.astro";
import { getSiteOrigin } from "../utils/site-url";

const siteOrigin = getSiteOrigin(Astro.url.origin);
const pageTitle = "What is My IP Address? Cloud Browser & WebRTC Leak Checker | BrowserReviews";
const pageDescription = "Check your public IPv4/IPv6 address, ISP hostname, location, and WebRTC leak vulnerabilities. Test whether your cloud browser instance or MCP agent is fully anonymous.";

// Server-side IP detection from reverse proxy headers
const clientIp = 
  Astro.request.headers.get("cf-connecting-ip") ||
  Astro.request.headers.get("x-forwarded-for")?.split(",")[0].trim() ||
  Astro.request.headers.get("x-real-ip") ||
  "Detecting...";

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Cloud Browser IP & WebRTC Leak Checker",
  url: `${siteOrigin}/my-ip`,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "All",
  description: pageDescription,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
};
---

<Base title={pageTitle} description={pageDescription} canonical="/my-ip">
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <div class="container" style="padding-top: 36px; padding-bottom: 72px;">
    <!-- Breadcrumbs -->
    <nav class="breadcrumbs" aria-label="Breadcrumb" style="margin-bottom: 24px; font-size: 13px; color: var(--color-ink-muted);">
      <a href="/" style="color: var(--color-ink-muted); text-decoration: none;">Home</a>
      <span>›</span>
      <span style="color: var(--color-ink);">What is My IP?</span>
    </nav>

    <!-- Header -->
    <header style="margin-bottom: 32px; text-align: center;">
      <span class="badge badge-primary" style="margin-bottom: 12px; display: inline-block;">Free Diagnostic Tool</span>
      <h1 style="font-size: clamp(28px, 4vw, 40px); font-weight: 800; margin: 0 0 12px 0; letter-spacing: -0.02em;">
        What is My IP Address &amp; WebRTC Leak Checker
      </h1>
      <p style="font-size: 16px; color: var(--color-ink-muted); max-width: 680px; margin: 0 auto; line-height: 1.6;">
        Verify your active public IP, geographic location, ISP network, and test for WebRTC address leaks to ensure your cloud browser instance or MCP agent is completely anonymous.
      </p>
    </header>

    <!-- IP Display Card -->
    <div style="max-width: 720px; margin: 0 auto 40px auto; background: var(--color-surface); border: 2px solid var(--color-primary); border-radius: var(--radius-lg); padding: 32px; text-align: center; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);">
      <div style="font-size: 13px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-ink-muted); margin-bottom: 8px;">
        Your Detected Public IP Address
      </div>
      <div id="ip-display" style="font-size: clamp(32px, 6vw, 48px); font-weight: 800; font-family: monospace; color: var(--color-primary); margin-bottom: 16px; word-break: break-all;">
        {clientIp}
      </div>

      <div style="display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; margin-bottom: 24px;">
        <span id="location-badge" class="badge badge-muted" style="font-size: 13px; padding: 6px 12px;">
          📍 Locating city &amp; country...
        </span>
        <span id="isp-badge" class="badge badge-muted" style="font-size: 13px; padding: 6px 12px;">
          🏢 Inspecting ISP &amp; ASN...
        </span>
        <span id="type-badge" class="badge badge-muted" style="font-size: 13px; padding: 6px 12px;">
          🔍 Checking route anonymity...
        </span>
      </div>

      <!-- Quick Action Buttons -->
      <div style="display: flex; justify-content: center; gap: 12px; flex-wrap: wrap;">
        <button id="copy-btn" class="btn btn-outline btn-sm" onclick="navigator.clipboard.writeText(document.getElementById('ip-display').innerText); this.innerText='✔ Copied!'; setTimeout(()=>this.innerText='Copy IP Address', 2000);">
          Copy IP Address
        </button>
        <button class="btn btn-primary btn-sm" onclick="window.location.reload();">
          🔄 Refresh Test
        </button>
      </div>
    </div>

    <!-- Diagnostic Details Grid -->
    <div style="max-width: 820px; margin: 0 auto 48px auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 20px;">
      <!-- Network Intelligence -->
      <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 24px;">
        <h3 style="font-size: 16px; font-weight: 700; margin: 0 0 16px 0; display: flex; align-items: center; gap: 8px;">
          🌐 Network Intelligence
        </h3>
        <table style="width: 100%; font-size: 14px; border-collapse: collapse;">
          <tbody>
            <tr style="border-bottom: 1px solid var(--color-border);">
              <td style="padding: 8px 0; color: var(--color-ink-muted);">Country:</td>
              <td id="info-country" style="padding: 8px 0; font-weight: 600; text-align: right;">Loading...</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-border);">
              <td style="padding: 8px 0; color: var(--color-ink-muted);">City / Region:</td>
              <td id="info-city" style="padding: 8px 0; font-weight: 600; text-align: right;">Loading...</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-border);">
              <td style="padding: 8px 0; color: var(--color-ink-muted);">ISP Organization:</td>
              <td id="info-isp" style="padding: 8px 0; font-weight: 600; text-align: right;">Loading...</td>
            </tr>
            <tr>
              <td style="padding: 8px 0; color: var(--color-ink-muted);">Autonomous System (ASN):</td>
              <td id="info-asn" style="padding: 8px 0; font-weight: 600; text-align: right; font-family: monospace;">Loading...</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- WebRTC Leak Vulnerability Test -->
      <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 24px;">
        <h3 style="font-size: 16px; font-weight: 700; margin: 0 0 16px 0; display: flex; align-items: center; gap: 8px;">
          🛡️ WebRTC Leak Detection
        </h3>
        <p style="font-size: 13px; color: var(--color-ink-muted); margin: 0 0 14px 0; line-height: 1.5;">
          WebRTC can bypass proxy layers and cloud browser bindings by querying local network interfaces via STUN protocols, exposing host IP addresses to anti-bot firewalls.
        </p>
        <div id="webrtc-status" style="background: var(--color-canvas-subtle); border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: 12px; font-size: 13px;">
          <div style="font-weight: 600; color: #10b981; margin-bottom: 4px;">
            ✔ Checking for WebRTC local/public candidates...
          </div>
          <div id="webrtc-candidates" style="font-family: monospace; font-size: 12px; color: var(--color-ink-muted);">
            No leak detected.
          </div>
        </div>
      </div>
    </div>

    <!-- Recommended Solution Banner -->
    <div style="max-width: 820px; margin: 0 auto 56px auto; background: linear-gradient(135deg, rgba(37, 99, 235, 0.08) 0%, rgba(37, 99, 235, 0.02) 100%); border: 1px solid rgba(37, 99, 235, 0.3); border-radius: var(--radius-lg); padding: 28px;">
      <div style="display: flex; gap: 8px; align-items: center; margin-bottom: 10px;">
        <span class="badge badge-primary" style="font-weight: 800;">Recommended Solution</span>
        <span style="font-size: 13px; color: var(--color-ink-muted);">Real GPU Cloud Browsers</span>
      </div>
      <h2 style="font-size: 20px; font-weight: 800; margin: 0 0 8px 0;">
        Need Completely Anonymous Cloud Browsers with Zero IP Leaks?
      </h2>
      <p style="font-size: 14px; color: var(--color-ink-muted); line-height: 1.6; margin: 0 0 16px 0;">
        Use <strong>2Captcha Cloud Browser</strong> (#1 Editor's Pick). Run authentic Google Chromium instances in GPU-accelerated sandboxes with integrated residential proxy routing, automated WebRTC masking, and built-in CAPTCHA solving starting at $0.05/hour.
      </p>
      <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <a href="https://2captcha.com/" target="_blank" rel="noopener" class="btn btn-primary">
          Explore 2Captcha Cloud Browser →
        </a>
        <a href="/connect-generator" class="btn btn-outline">
          Connect &amp; MCP Generator
        </a>
        <a href="/browser-audit" class="btn btn-outline">
          Run Full Browser Audit
        </a>
      </div>
    </div>

    <!-- Educational Guide -->
    <div style="max-width: 820px; margin: 0 auto;">
      <h2 style="font-size: 22px; font-weight: 800; margin: 0 0 14px 0;">
        How Cloud Browsers &amp; MCP Agents Prevent IP Leaks
      </h2>
      <div style="font-size: 15px; color: var(--color-ink-muted); line-height: 1.7;">
        <p>
          When executing automated web workflows, target security systems (Cloudflare, DataDome, Akamai) cross-reference multiple IP signals: HTTP request origin headers, TCP socket handshakes, and STUN candidate addresses emitted by browser WebRTC APIs.
        </p>
        <h3 style="font-size: 17px; font-weight: 700; color: var(--color-ink); margin: 24px 0 8px 0;">
          Why WebRTC Leaks Defeat Standard Proxies
        </h3>
        <p>
          Even when standard headless Chromium routes HTTP requests through an upstream proxy, default WebRTC implementations query local network interfaces directly. If STUN queries bypass the proxy tunnel, your real IP is exposed in JavaScript readbacks, resulting in instant bot flags.
        </p>

        <h3 style="font-size: 17px; font-weight: 700; color: var(--color-ink); margin: 24px 0 8px 0;">
          Verifying Cloud Browser Stealth
        </h3>
        <p>
          Navigate to this page using your Playwright or Puppeteer script via your remote WebSocket endpoint (`browserWSEndpoint`). If properly configured, the IP address displayed above will match the cloud provider's proxy exit IP, and the WebRTC candidate check will report zero local host leaks.
        </p>
      </div>

      <!-- Cross Links -->
      <div style="border-top: 1px solid var(--color-border); margin-top: 40px; padding-top: 24px;">
        <h3 style="font-size: 16px; margin: 0 0 12px 0;">Diagnostic Tools &amp; Resources</h3>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
          <a href="/browsers" class="btn btn-outline btn-sm">All Cloud Browsers</a>
          <a href="/mcp" class="btn btn-outline btn-sm">Browser MCP Directory</a>
          <a href="/browser-audit" class="btn btn-outline btn-sm">Hardware &amp; WebGL Audit</a>
          <a href="/tls-fingerprint" class="btn btn-outline btn-sm">TLS &amp; JA4 Tester</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Client-side Diagnostic Script -->
  <script is:inline>
    // 1. Client-side IP and Geolocation resolution fallback
    fetch('https://ipapi.co/json/')
      .then(r => r.json())
      .then(data => {
        if (data.ip) {
          const ipEl = document.getElementById('ip-display');
          if (ipEl && (ipEl.innerText.includes('Detecting') || ipEl.innerText.trim() === '')) {
            ipEl.innerText = data.ip;
          }
          document.getElementById('location-badge').innerText = `📍 ${data.city || ''}, ${data.country_name || 'Global'}`;
          document.getElementById('isp-badge').innerText = `🏢 ${data.org || data.asn || 'Commercial ISP'}`;
          document.getElementById('type-badge').innerText = data.in_eu ? '🇪🇺 European Union' : '🌐 Global Route';
          
          document.getElementById('info-country').innerText = `${data.country_name || ''} (${data.country_code || ''})`;
          document.getElementById('info-city').innerText = `${data.city || 'Unknown'}, ${data.region || ''}`;
          document.getElementById('info-isp').innerText = data.org || 'ISP Network';
          document.getElementById('info-asn').innerText = `${data.asn || 'AS0000'} (${data.org || ''})`;
        }
      })
      .catch(() => {
        document.getElementById('location-badge').innerText = '📍 Geolocation secured';
        document.getElementById('isp-badge').innerText = '🏢 Verified Route';
      });

    // 2. Client-side WebRTC Leak Inspection
    try {
      const rtc = new RTCPeerConnection({ iceServers: [{ urls: "stun:stun.l.google.com:19302" }] });
      rtc.createDataChannel("");
      rtc.createOffer().then(offer => rtc.setLocalDescription(offer));
      rtc.onicecandidate = (event) => {
        if (!event || !event.candidate) return;
        const candidate = event.candidate.candidate;
        const ipRegex = /([0-9]{1,3}(\.[0-9]{1,3}){3}|[a-f0-9]{1,4}(:[a-f0-9]{1,4}){7})/;
        const match = candidate.match(ipRegex);
        if (match && match[1]) {
          const leakedIp = match[1];
          if (!leakedIp.startsWith('192.168.') && !leakedIp.startsWith('10.') && !leakedIp.startsWith('172.')) {
            const el = document.getElementById('webrtc-candidates');
            if (el) el.innerHTML = `<span style="color: #ef4444;">⚠️ WebRTC Public Candidate Detected: <strong>${leakedIp}</strong></span>`;
          }
        }
      };
    } catch (e) {
      const el = document.getElementById('webrtc-candidates');
      if (el) el.innerHTML = `<span style="color: #10b981;">✔ WebRTC is disabled or blocked. Complete privacy!</span>`;
    }
  </script>
</Base>
