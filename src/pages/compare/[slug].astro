---
import { decodeSlug } from "emdash";
import Base from "../../layouts/Base.astro";
import { fetchAllBrowsers, fetchBrowserBySlug, fetchAllMcpTools, fetchMcpToolBySlug } from "../../utils/browser-data";

const rawSlug = decodeSlug(Astro.params.slug);

if (!rawSlug || !rawSlug.includes("-vs-")) {
  return Astro.redirect("/compare");
}

const parts = rawSlug.split("-vs-");
const slugA = parts[0];
const slugB = parts[1];

// Try resolving as browsers first
let itemA: any = null;
let itemB: any = null;
let isMcpComparison = false;

const { browser: browserA } = await fetchBrowserBySlug(slugA);
const { browser: browserB } = await fetchBrowserBySlug(slugB);

if (browserA && browserB) {
  itemA = browserA;
  itemB = browserB;
} else {
  // Try resolving as MCP tools
  const { tool: toolA } = await fetchMcpToolBySlug(slugA);
  const { tool: toolB } = await fetchMcpToolBySlug(slugB);
  if (toolA && toolB) {
    itemA = toolA;
    itemB = toolB;
    isMcpComparison = true;
  }
}

if (!itemA || !itemB) {
  return Astro.redirect("/compare");
}

const siteTitle = `${itemA.name} vs ${itemB.name}: 2026 Comparison • BrowserReviews`;
const siteDescription = `Head-to-head comparison of ${itemA.name} vs ${itemB.name}. Compare anti-bot bypass rates, automated CAPTCHA solving, pricing, and performance benchmarks.`;
---

<Base title={siteTitle} description={siteDescription}>
  <div class="compare-container">
    <div class="breadcrumb">
      <a href="/">Home</a> <span>/</span>
      <a href="/compare">Compare</a> <span>/</span>
      <span>{itemA.name} vs {itemB.name}</span>
    </div>

    <!-- Header -->
    <div class="compare-header">
      <span class="badge-head">Head-to-Head Architectural Comparison</span>
      <h1 class="compare-title">{itemA.name} <span class="vs-text">vs</span> {itemB.name}</h1>
      <p class="compare-subtitle">
        Independent lab benchmark comparing anti-bot bypass, automated CAPTCHA decoding, CDP stability, and compute pricing.
      </p>
    </div>

    <!-- Dual Cards Summary -->
    <div class="dual-cards-row">
      <!-- Item A -->
      <div class={`comp-box ${itemA.demo_rank === 1 ? "box-winner" : ""}`}>
        <div class="box-top">
          <span class="rank-tag">#{itemA.demo_rank} {isMcpComparison ? "MCP" : "Cloud Browser"}</span>
          <span class="score-tag">★ {itemA.overall_score.toFixed(1)}</span>
        </div>
        <h2 class="box-title">{itemA.name}</h2>
        <p class="box-tagline">{itemA.tagline}</p>
        <div class="box-rate">
          {!isMcpComparison ? (
            <span><strong>${itemA.starting_price_hour.toFixed(2)}</strong> / hr</span>
          ) : (
            <span>{itemA.pricing_tier.split(';')[0]}</span>
          )}
        </div>
        <a href={!isMcpComparison ? `/reviews/${itemA.slug}` : `/mcp/${itemA.slug}`} class="btn btn-outline">Read Full Review</a>
      </div>

      <!-- Item B -->
      <div class={`comp-box ${itemB.demo_rank === 1 ? "box-winner" : ""}`}>
        <div class="box-top">
          <span class="rank-tag">#{itemB.demo_rank} {isMcpComparison ? "MCP" : "Cloud Browser"}</span>
          <span class="score-tag">★ {itemB.overall_score.toFixed(1)}</span>
        </div>
        <h2 class="box-title">{itemB.name}</h2>
        <p class="box-tagline">{itemB.tagline}</p>
        <div class="box-rate">
          {!isMcpComparison ? (
            <span><strong>${itemB.starting_price_hour.toFixed(2)}</strong> / hr</span>
          ) : (
            <span>{itemB.pricing_tier.split(';')[0]}</span>
          )}
        </div>
        <a href={!isMcpComparison ? `/reviews/${itemB.slug}` : `/mcp/${itemB.slug}`} class="btn btn-outline">Read Full Review</a>
      </div>
    </div>

    <!-- Comparison Matrix -->
    <div class="matrix-section">
      <h2 class="section-title">Head-to-Head Specifications Matrix</h2>
      <div class="table-responsive">
        <table class="matrix-table">
          <thead>
            <tr>
              <th style="width: 28%;">Feature / Metric</th>
              <th style="width: 36%;">{itemA.name}</th>
              <th style="width: 36%;">{itemB.name}</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Editorial Lab Score</strong></td>
              <td><strong class="text-green">★ {itemA.overall_score.toFixed(1)} / 10</strong></td>
              <td><strong class="text-green">★ {itemB.overall_score.toFixed(1)} / 10</strong></td>
            </tr>
            {!isMcpComparison ? (
              <>
                <tr>
                  <td><strong>Starting Price / Hour</strong></td>
                  <td>${itemA.starting_price_hour.toFixed(2)} / hr</td>
                  <td>${itemB.starting_price_hour.toFixed(2)} / hr</td>
                </tr>
                <tr>
                  <td><strong>Pricing Model</strong></td>
                  <td>{itemA.pricing_model.replace(/_/g, " ")}</td>
                  <td>{itemB.pricing_model.replace(/_/g, " ")}</td>
                </tr>
                <tr>
                  <td><strong>CAPTCHA Auto-Solve</strong></td>
                  <td class={itemA.captcha_auto_solve.includes("Native") ? "text-green" : ""}>{itemA.captcha_auto_solve}</td>
                  <td class={itemB.captcha_auto_solve.includes("Native") ? "text-green" : ""}>{itemB.captcha_auto_solve}</td>
                </tr>
                <tr>
                  <td><strong>Anti-Bot Bypass</strong></td>
                  <td>{itemA.antibot_bypass}</td>
                  <td>{itemB.antibot_bypass}</td>
                </tr>
                <tr>
                  <td><strong>Residential Proxy Integration</strong></td>
                  <td>{itemA.proxy_integration}</td>
                  <td>{itemB.proxy_integration}</td>
                </tr>
                <tr>
                  <td><strong>CDP WebSocket (wss://)</strong></td>
                  <td>{itemA.cdp_support ? "✔ Standard CDP" : "✖ No"}</td>
                  <td>{itemB.cdp_support ? "✔ Standard CDP" : "✖ No"}</td>
                </tr>
                <tr>
                  <td><strong>Max Concurrency</strong></td>
                  <td>{itemA.max_concurrency}</td>
                  <td>{itemB.max_concurrency}</td>
                </tr>
              </>
            ) : (
              <>
                <tr>
                  <td><strong>Exposed Tools Count</strong></td>
                  <td><strong>{itemA.tools_provided.length} Tools</strong></td>
                  <td><strong>{itemB.tools_provided.length} Tools</strong></td>
                </tr>
                <tr>
                  <td><strong>Claude Desktop Support</strong></td>
                  <td>{itemA.supports_claude_desktop ? "✔ Yes" : "✖ No"}</td>
                  <td>{itemB.supports_claude_desktop ? "✔ Yes" : "✖ No"}</td>
                </tr>
                <tr>
                  <td><strong>Cursor IDE Support</strong></td>
                  <td>{itemA.supports_cursor ? "✔ Yes" : "✖ No"}</td>
                  <td>{itemB.supports_cursor ? "✔ Yes" : "✖ No"}</td>
                </tr>
                <tr>
                  <td><strong>CAPTCHA Solving</strong></td>
                  <td class={itemA.captcha_solving.includes("Native") ? "text-green" : ""}>{itemA.captcha_solving}</td>
                  <td class={itemB.captcha_solving.includes("Native") ? "text-green" : ""}>{itemB.captcha_solving}</td>
                </tr>
                <tr>
                  <td><strong>Stealth Engine</strong></td>
                  <td>{itemA.stealth_bypass}</td>
                  <td>{itemB.stealth_bypass}</td>
                </tr>
              </>
            )}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Editorial Comparison Verdict -->
    <div class="verdict-card">
      <h2 class="verdict-title">Editorial Verdict & Recommendation</h2>
      <div class="verdict-content">
        <p>
          When choosing between <strong>{itemA.name}</strong> and <strong>{itemB.name}</strong>, the decision hinges on your pipeline's primary operational bottleneck:
        </p>
        <p>
          <strong>{itemA.name}:</strong> {itemA.ideal_use_case}
        </p>
        <p>
          <strong>{itemB.name}:</strong> {itemB.ideal_use_case}
        </p>
        <p class="final-recommendation">
          {itemA.demo_rank < itemB.demo_rank ? (
            <span>Overall, <strong>{itemA.name}</strong> earns our higher rating (Rank #{itemA.demo_rank}) due to superior unit economics and integrated anti-bot bypass.</span>
          ) : (
            <span>Overall, <strong>{itemB.name}</strong> earns our higher rating (Rank #{itemB.demo_rank}) due to superior unit economics and integrated anti-bot bypass.</span>
          )}
        </p>
      </div>
    </div>
  </div>
</Base>

<style>
  .compare-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 2.5rem 0 4rem;
  }
  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }
  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .breadcrumb span {
    margin: 0 0.35rem;
  }

  .compare-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  .badge-head {
    display: inline-block;
    padding: 0.3rem 0.75rem;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    background: #dbeafe;
    color: #1e40af;
    border-radius: 999px;
    margin-bottom: 0.75rem;
  }
  .compare-title {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 800;
    margin-bottom: 0.75rem;
  }
  .vs-text {
    color: var(--color-primary);
    font-weight: 900;
  }
  .compare-subtitle {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.5;
  }

  .dual-cards-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }
  @media (max-width: 650px) {
    .dual-cards-row {
      grid-template-columns: 1fr;
    }
  }

  .comp-box {
    background: var(--color-card-bg, #ffffff);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .box-winner {
    border: 2px solid #10b981;
    background: linear-gradient(to bottom, rgba(16, 185, 129, 0.04), var(--color-card-bg, #ffffff));
  }
  .box-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }
  .rank-tag {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    background: #e2e8f0;
    border-radius: 4px;
    color: #1e293b;
  }
  .score-tag {
    font-weight: 700;
    color: #059669;
  }
  .box-title {
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
  }
  .box-tagline {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.45;
    margin-bottom: 1.25rem;
  }
  .box-rate {
    font-size: 1.15rem;
    margin-bottom: 1.25rem;
    color: var(--color-text);
  }
  .btn-outline {
    display: block;
    text-align: center;
    padding: 0.6rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--color-text);
  }
  .btn-outline:hover {
    background: var(--color-bg-secondary, #f8fafc);
  }

  .matrix-section {
    margin-bottom: 3rem;
  }
  .section-title {
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }
  .table-responsive {
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-card-bg, #ffffff);
  }
  .matrix-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }
  .matrix-table th {
    padding: 1rem 1.25rem;
    background: var(--color-bg-secondary, #f8fafc);
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    font-weight: 700;
  }
  .matrix-table td {
    padding: 0.9rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }
  .text-green {
    color: #059669;
  }

  .verdict-card {
    background: var(--color-bg-secondary, #f8fafc);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 2rem;
    margin-bottom: 3rem;
  }
  .verdict-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }
  .verdict-content {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text);
  }
  .final-recommendation {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }
</style>
