---
import Base from "../../layouts/Base.astro";
import { getSiteOrigin } from "../../utils/site-url";

const siteOrigin = getSiteOrigin(Astro.url.origin);
const pageTitle = "Free Cloud Browser & Headless Developer Tools (2026) | BrowserReviews";
const pageDescription = "Free online developer tools for AI agents and cloud browser automation: Connect & MCP Config Generator, TLS JA4 Fingerprinter, WebGL GPU Leak Audit, and Compute Calculator.";

const schema = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	name: pageTitle,
	description: pageDescription,
	url: `${siteOrigin}/tools/`,
	publisher: {
		"@type": "Organization",
		name: "BrowserReviews",
		url: siteOrigin,
	},
};

const tools = [
	{
		title: "Connect & MCP Config Generator",
		slug: "/connect-generator/",
		badge: "AI Agent Configurator",
		badgeType: "badge-primary",
		icon: "⚡",
		desc: "Generate ready-to-run connection scripts and JSON configurations for Claude Desktop, Cursor, Windsurf Cascade, Python Playwright, and Puppeteer with 2Captcha Browser MCP.",
		tag: "Claude / Cursor / Windsurf / Playwright"
	},
	{
		title: "TLS & JA4 Fingerprint Analyzer",
		slug: "/tls-fingerprint/",
		badge: "Anti-Detect Audit",
		badgeType: "badge-accent",
		icon: "🔒",
		desc: "Analyze client TLS ClientHello fingerprints, JA3, JA4 hashes, and Akamai HTTP/2 frame signatures to debug Cloudflare Turnstile and DataDome connection drops.",
		tag: "JA3 / JA4 / H2 Frames"
	},
	{
		title: "Browser Leak & Anti-Detect Audit",
		slug: "/browser-audit/",
		badge: "Fingerprint Scanner",
		badgeType: "badge-award",
		icon: "🛡️",
		desc: "Inspect WebGL GPU unmasked renderer, Canvas 2D noise, AudioContext latency, and navigator.webdriver flags to verify that headless browser sessions look 100% human.",
		tag: "WebGL / Canvas / Webdriver"
	},
	{
		title: "What is My IP & WebRTC Leak Test",
		slug: "/my-ip/",
		badge: "Proxy Audit",
		badgeType: "badge-subtle",
		icon: "🌐",
		desc: "Audit your cloud browser exit IP, geolocations, ISP classification, and verify whether WebRTC STUN/TURN requests leak your real host infrastructure.",
		tag: "STUN / WebRTC / Residential IP"
	},
	{
		title: "Cloud Browser Compute Calculator",
		slug: "/calculator/",
		badge: "Cost Estimator",
		badgeType: "badge-primary",
		icon: "📊",
		desc: "Model monthly compute hours and bandwidth costs. Compare 2Captcha Browser API at $0.05/hr against Browserbase ($0.20/hr) and Bright Data ($8.40/GB).",
		tag: "Hours & Concurrency Calculator"
	},
	{
		title: "Cloud Browser Alternatives Matrix",
		slug: "/alternatives/",
		badge: "Comparison Hub",
		badgeType: "badge-accent",
		icon: "🔄",
		desc: "Direct side-by-side technical comparisons, feature matrices, anti-bot bypass support, and migration recipes across leading headless cloud platforms.",
		tag: "Competitor Comparison Directory"
	},
	{
		title: "40+ Open-Source Scraping Targets",
		slug: "https://scrapingreview.com/targets",
		isExternal: true,
		badge: "Sister Network",
		badgeType: "badge-award",
		icon: "📦",
		desc: "Production-ready Python scraping blueprints for Amazon, TikTok, Shein, Etsy, and 40+ platforms with built-in remote cloud browser support.",
		tag: "ScrapingReview.com ↗"
	}
];
---

<Base title={pageTitle} description={pageDescription}>
	<script type="application/ld+json" set:html={JSON.stringify(schema)} />

	<div class="container" style="padding-top: 36px; padding-bottom: 72px;">
		<!-- Breadcrumbs -->
		<nav class="breadcrumbs" aria-label="Breadcrumb" style="margin-bottom: 24px; font-size: 13px; color: var(--color-ink-muted);">
			<a href="/" style="color: var(--color-ink-muted); text-decoration: none;">Home</a>
			<span style="margin: 0 8px;">/</span>
			<span style="color: var(--color-ink);">Developer Tools</span>
		</nav>

		<!-- Header -->
		<header style="margin-bottom: 36px; text-align: center;">
			<span class="badge badge-primary" style="margin-bottom: 12px; display: inline-block;">Free Engineering Utility Suite</span>
			<h1 style="font-size: clamp(28px, 4vw, 44px); font-weight: 800; line-height: 1.25; margin: 0 0 16px 0; letter-spacing: -0.02em;">
				Cloud Browser &amp; AI Agent Tools
			</h1>
			<p style="font-size: 16px; color: var(--color-ink-muted); max-width: 760px; margin: 0 auto; line-height: 1.6;">
				Online developer tools for configuring AI agent MCP servers, inspecting anti-bot fingerprints, generating automation code, and modeling cloud browser compute costs.
			</p>
		</header>

		<!-- Tools Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 20px; margin-bottom: 48px;">
			{tools.map((t) => (
				<a
					href={t.slug}
					target={t.isExternal ? "_blank" : undefined}
					rel={t.isExternal ? "noopener" : undefined}
					style="text-decoration: none; color: inherit; display: block;"
				>
					<div class="card" style="padding: 24px; height: 100%; display: flex; flex-direction: column; justify-content: space-between; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); transition: transform 0.15s ease, border-color 0.15s ease;">
						<div>
							<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
								<div style="font-size: 28px; line-height: 1;">{t.icon}</div>
								<span class={`badge ${t.badgeType}`}>{t.badge}</span>
							</div>
							<h2 style="font-size: 18px; font-weight: 800; margin: 0 0 8px 0; color: var(--color-ink); line-height: 1.35;">
								{t.title}
							</h2>
							<p style="font-size: 13.5px; color: var(--color-ink-muted); line-height: 1.55; margin: 0 0 16px 0;">
								{t.desc}
							</p>
						</div>

						<div style="border-top: 1px solid var(--color-border); padding-top: 14px; display: flex; justify-content: space-between; align-items: center; font-size: 12.5px;">
							<span style="font-family: var(--font-mono); color: var(--color-ink-muted);">{t.tag}</span>
							<span style="color: var(--color-primary); font-weight: 700;">Open Tool →</span>
						</div>
					</div>
				</a>
			))}
		</div>

		<!-- Recommended Provider Banner -->
		<div style="background: linear-gradient(135deg, rgba(245, 158, 11, 0.1) 0%, rgba(245, 158, 11, 0.02) 100%); border: 2px solid var(--color-primary); border-radius: var(--radius-lg); padding: 32px;">
			<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 8px;">
				<span class="badge badge-accent">#1 Ranked Cloud Browser &amp; MCP Protocol Engine</span>
				<span style="font-size: 13.5px; font-weight: 700; color: var(--color-primary);">$0.05 / Hour Compute</span>
			</div>
			<h2 style="font-size: 24px; font-weight: 800; margin: 0 0 10px 0; color: var(--color-ink);">
				Power Claude, Cursor &amp; Playwright with 2Captcha Browser
			</h2>
			<p style="font-size: 14.5px; color: var(--color-ink-muted); line-height: 1.6; margin: 0 0 20px 0; max-width: 800px;">
				Built-in automated CAPTCHA resolution (Turnstile, reCAPTCHA, hCaptcha), residential IP proxy rotation, and full Chrome DevTools Protocol (CDP) WebSocket compatibility at $0.05/hour with zero monthly minimums.
			</p>
			<div style="display: flex; gap: 14px; flex-wrap: wrap;">
				<a href="https://2captcha.com" target="_blank" rel="noopener" class="btn btn-primary">
					Launch 2Captcha Cloud Browser →
				</a>
				<a href="/reviews/2captcha-browser-api" class="btn btn-outline">
					Read Browser API Benchmark Review
				</a>
				<a href="/connect-generator" class="btn btn-secondary">
					Generate Agent Config
				</a>
			</div>
		</div>
	</div>
</Base>
