---
import Base from "../layouts/Base.astro";

const siteTitle = "Page Not Found (404) • BrowserReviews";
const siteDescription = "The page you requested could not be found. Explore our Cloud Browser Directory and Browser MCP Tools.";
---

<Base title={siteTitle} description={siteDescription}>
  <div class="error-container">
    <div class="error-badge">404 Error</div>
    <h1 class="error-title">Page Not Found</h1>
    <p class="error-desc">
      The cloud browser review, MCP documentation, or guide you are looking for has been moved or does not exist.
    </p>

    <div class="quick-links">
      <a href="/browsers" class="btn btn-primary">Browse 60 Cloud Browsers →</a>
      <a href="/mcp" class="btn btn-purple">Explore 32 Browser MCP Tools →</a>
      <a href="/" class="btn btn-outline">Return to Homepage</a>
    </div>
  </div>
</Base>

<style>
  .error-container {
    max-width: 600px;
    margin: 4rem auto 6rem;
    text-align: center;
    padding: 2rem;
  }
  .error-badge {
    display: inline-block;
    padding: 0.35rem 0.85rem;
    font-size: 0.85rem;
    font-weight: 700;
    background: #fee2e2;
    color: #991b1b;
    border-radius: 999px;
    margin-bottom: 1rem;
  }
  .error-title {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 1rem;
  }
  .error-desc {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: 2rem;
  }
  .quick-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 320px;
    margin: 0 auto;
  }
  .btn {
    padding: 0.75rem 1.25rem;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .btn-primary {
    background: var(--color-primary);
    color: #ffffff;
  }
  .btn-purple {
    background: #8b5cf6;
    color: #ffffff;
  }
  .btn-outline {
    border: 1px solid var(--color-border);
    color: var(--color-text);
  }
</style>
