				consistencyVal.textContent = "100% Consistent";
				consistencySub.textContent = "NSS matches Firefox User-Agent";
			} else if (isSafari) {
				engineDetected.textContent = "Apple SecureTransport (Safari / WebKit)";
				engineSub.textContent = "Apple Silicon / iOS Native TLS Stack";
				trustScoreVal.textContent = "97 / 100";
				trustScoreBadge.textContent = "✅ Verified Human Browser Profile";
				consistencyVal.textContent = "100% Consistent";
				consistencySub.textContent = "SecureTransport matches Safari User-Agent";
			} else {
				engineDetected.textContent = "Standard Chromium Web Engine";
				trustScoreVal.textContent = "95 / 100";
			}
		}

		// Initial automatic scan on page load
		runAudit();
	});
</script>
