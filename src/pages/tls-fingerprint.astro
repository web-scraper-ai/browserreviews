---
import Base from "../layouts/Base.astro";
import { getSiteOrigin } from "../utils/site-url";

const siteOrigin = getSiteOrigin(Astro.url.origin);
const pageTitle = "TLS & JA4 Browser Fingerprint Test (JA3, Akamai H2, Anti-Bot Audit) | BrowserReviews";
const pageDescription =
	"Free online TLS client tester. Inspect your browser's JA4 & JA3 fingerprint, Akamai HTTP/2 signature, cipher suites, and anti-bot evasion score. Learn how to bypass TLS fingerprint blocking with Cloud Browsers.";

const schema = {
	"@context": "https://schema.org",
	"@type": "WebApplication",
	name: "TLS & JA4 Browser Fingerprint Tester",
	url: `${siteOrigin}/tls-fingerprint`,
	applicationCategory: "DeveloperApplication",
	operatingSystem: "All",
	description: pageDescription,
	offers: {
		"@type": "Offer",
		price: "0",
		priceCurrency: "USD",
	},
};

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: [
		{
			"@type": "Question",
			name: "What is a JA4 TLS Fingerprint?",
			acceptedAnswer: {
				"@type": "Answer",
				text: "JA4 is the modern cryptographic standard for client fingerprinting developed by FoxIO in 2023. It analyzes the unencrypted ClientHello packet during TLS handshakes. Unlike JA3, JA4 sorts extensions and ciphers to resist Chrome's randomized extension shuffling, producing a reliable, human-readable 36-character signature.",
			},
		},
		{
			"@type": "Question",
			name: "Why does spoofing User-Agent fail against Cloudflare and DataDome?",
			acceptedAnswer: {
				"@type": "Answer",
				text: "Anti-bot systems inspect the TLS ClientHello handshake before reading HTTP headers. Standard libraries like Python requests, Go net/http, or curl use OpenSSL cipher lists and lack GREASE values. When the WAF detects an OpenSSL TLS fingerprint paired with a Chrome User-Agent header, it flags the request as a spoofed bot immediately.",
			},
		},
		{
			"@type": "Question",
			name: "How does 2Captcha Cloud Browser solve TLS fingerprinting?",
			acceptedAnswer: {
				"@type": "Answer",
				text: "2Captcha Cloud Browser runs genuine, full-featured Chromium instances in cloud sandboxes. Every request originates from authentic Google Chrome networking binaries (BoringSSL with GREASE and HTTP/2 multiplexing), producing 100% human-grade JA3, JA4, and Akamai fingerprints.",
			},
		},
		{
			"@type": "Question",
			name: "What is Akamai HTTP/2 Fingerprinting?",
			acceptedAnswer: {
				"@type": "Answer",
				text: "Akamai HTTP/2 fingerprinting hashes the initial SETTINGS frame parameters (such as HEADER_TABLE_SIZE, INITIAL_WINDOW_SIZE, and MAX_FRAME_SIZE), WINDOW_UPDATE increments, and pseudo-header ordering (:method, :authority, :scheme, :path) sent by the browser upon opening an HTTP/2 connection.",
			},
		},
	],
};
---

<Base title={pageTitle} description={pageDescription} canonical="/tls-fingerprint">
	<script type="application/ld+json" set:html={JSON.stringify(schema)} />
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<div class="page-header" style="padding-top: 32px; padding-bottom: 24px; text-align: center;">
		<div class="breadcrumb" style="justify-content: center; margin-bottom: 12px; font-size: 13px; color: var(--color-ink-muted);">
			<a href="/" style="color: var(--color-ink-muted); text-decoration: none;">Home</a> <span>/</span>
			<a href="/browsers" style="color: var(--color-ink-muted); text-decoration: none;">Tools</a> <span>/</span>
			<span style="color: var(--color-ink); font-weight: 600;">TLS Fingerprint Tester</span>
		</div>
		<span class="badge badge-primary" style="margin-bottom: 12px; display: inline-block;">
			🔒 Live Security Telemetry
		</span>
		<h1 class="page-title" style="font-size: clamp(28px, 4vw, 42px); font-weight: 800; margin: 0 0 12px 0; letter-spacing: -0.02em;">
			TLS &amp; JA4 Browser Fingerprint Tester
		</h1>
		<p class="page-subtitle" style="font-size: 16px; color: var(--color-ink-muted); max-width: 760px; margin: 0 auto; line-height: 1.6;">
			Inspect your browser's unencrypted ClientHello packet in real-time. Analyze modern JA4 and legacy JA3 digests, Akamai HTTP/2 frame signatures, cipher suites, and anti-bot evasion trust scores.
		</p>
	</div>

	<div class="container" style="max-width: 1100px; margin: 0 auto; padding: 0 16px 64px 16px;">
		<!-- Live Diagnostic Controller Card -->
		<div class="card" style="padding: 24px 28px; margin-bottom: 28px; border: 1px solid var(--color-border); background: var(--color-surface); border-radius: var(--radius-lg); box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
			<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
				<div style="display: flex; align-items: center; gap: 14px;">
					<div id="status-pulse" style="width: 14px; height: 14px; border-radius: 50%; background: #10b981; box-shadow: 0 0 0 4px rgba(16,185,129,0.2); animation: pulse 2s infinite;"></div>
					<div>
						<div id="status-title" style="font-weight: 800; font-size: 16px; color: var(--color-ink);">Analyzing ClientHello Handshake...</div>
						<div id="status-desc" style="font-size: 13px; color: var(--color-ink-muted);">Capturing TLS ciphers, extensions, and HTTP/2 frames directly from your browser connection</div>
					</div>
				</div>
				<button type="button" id="btn-rescan" class="btn btn-primary" style="padding: 10px 20px; font-weight: 700; font-size: 14px; cursor: pointer; display: flex; align-items: center; gap: 8px;">
					<span>🔄</span> Re-Audit Handshake
				</button>
			</div>
		</div>

		<!-- Top Anti-Bot Trust Score Banner -->
		<div id="trust-banner" class="card" style="padding: 24px 28px; margin-bottom: 28px; border: 1px solid #a7f3d0; background: #ecfdf5; border-radius: var(--radius-lg); display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; align-items: center;">
			<div>
				<div style="font-size: 11px; text-transform: uppercase; font-weight: 800; letter-spacing: 0.05em; color: #047857; margin-bottom: 4px;">Anti-Bot Trust Score</div>
				<div id="trust-score-val" style="font-size: 32px; font-weight: 900; color: #065f46; line-height: 1.1;">98 / 100</div>
				<div id="trust-score-badge" style="font-size: 12px; font-weight: 700; color: #059669; margin-top: 4px;">✅ Verified Human Browser Profile</div>
			</div>
			<div>
				<div style="font-size: 11px; text-transform: uppercase; font-weight: 800; letter-spacing: 0.05em; color: var(--color-ink-muted); margin-bottom: 4px;">Detected Cryptographic Engine</div>
				<div id="engine-detected" style="font-size: 18px; font-weight: 800; color: var(--color-ink);">BoringSSL (Chromium 131+)</div>
				<div id="engine-sub" style="font-size: 12px; color: var(--color-ink-muted); margin-top: 4px;">Post-Quantum Kyber768 Key Shares Present</div>
			</div>
			<div>
				<div style="font-size: 11px; text-transform: uppercase; font-weight: 800; letter-spacing: 0.05em; color: var(--color-ink-muted); margin-bottom: 4px;">User-Agent vs TLS Consistency</div>
				<div id="consistency-val" style="font-size: 18px; font-weight: 800; color: #059669;">100% Consistent</div>
				<div id="consistency-sub" style="font-size: 12px; color: var(--color-ink-muted); margin-top: 4px;">No User-Agent spoofing discrepancy detected</div>
			</div>
		</div>

		<!-- 4 Core Fingerprint Cards Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; margin-bottom: 32px;">
			<!-- Card 1: JA4 Fingerprint (Modern Standard) -->
			<div class="card" style="padding: 24px; border: 1px solid var(--color-border); background: var(--color-surface); border-radius: var(--radius-md);">
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
					<span class="badge badge-primary" style="font-size: 11px; font-weight: 700;">Modern Standard (FoxIO 2023)</span>
					<button type="button" class="btn-copy-sm" data-target="ja4-full" style="background: none; border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: 4px 10px; font-size: 11px; cursor: pointer; color: var(--color-ink);">Copy JA4</button>
				</div>
				<h3 style="margin: 0 0 8px 0; font-size: 18px; font-weight: 800; color: var(--color-ink);">JA4 Fingerprint</h3>
				<p style="margin: 0 0 14px 0; font-size: 12px; color: var(--color-ink-muted); line-height: 1.5;">
					Resistant to Chrome's randomized extension shuffling. The primary fingerprint used by Cloudflare &amp; DataDome.
				</p>
				<div style="background: #0f172a; padding: 12px 14px; border-radius: var(--radius-sm); border: 1px solid #1e293b; margin-bottom: 14px;">
					<code id="ja4-full" style="font-family: var(--font-mono); font-size: 14px; font-weight: 700; color: #38bdf8; word-break: break-all;">t13d3112h2_e8f1e7e78f70_b26ce05bbdd6</code>
				</div>
				<!-- JA4 Breakdown Pills -->
				<div style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--color-ink-muted); margin-bottom: 8px;">JA4 Section Decomposition:</div>
				<div style="display: flex; flex-wrap: wrap; gap: 6px; font-size: 11px;">
					<span class="badge" style="background: var(--color-canvas-muted); color: var(--color-ink);"><strong id="ja4-p-proto">t</strong> (TCP)</span>
					<span class="badge" style="background: var(--color-canvas-muted); color: var(--color-ink);"><strong id="ja4-p-ver">13</strong> (TLS 1.3)</span>
					<span class="badge" style="background: var(--color-canvas-muted); color: var(--color-ink);"><strong id="ja4-p-sni">d</strong> (SNI Domain)</span>
					<span class="badge" style="background: var(--color-canvas-muted); color: var(--color-ink);"><strong id="ja4-p-ciphers">31</strong> Ciphers</span>
					<span class="badge" style="background: var(--color-canvas-muted); color: var(--color-ink);"><strong id="ja4-p-ext">12</strong> Extensions</span>
					<span class="badge" style="background: var(--color-canvas-muted); color: var(--color-ink);"><strong id="ja4-p-alpn">h2</strong> (HTTP/2)</span>
				</div>
			</div>

			<!-- Card 2: JA3 Fingerprint (Legacy MD5) -->
			<div class="card" style="padding: 24px; border: 1px solid var(--color-border); background: var(--color-surface); border-radius: var(--radius-md);">
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
					<span class="badge" style="background: var(--color-canvas-muted); color: var(--color-ink-muted); font-size: 11px; font-weight: 700;">Legacy Standard (Salesforce 2017)</span>
					<button type="button" class="btn-copy-sm" data-target="ja3-hash" style="background: none; border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: 4px 10px; font-size: 11px; cursor: pointer; color: var(--color-ink);">Copy JA3</button>
				</div>
				<h3 style="margin: 0 0 8px 0; font-size: 18px; font-weight: 800; color: var(--color-ink);">JA3 Digest &amp; Raw Hash</h3>
				<p style="margin: 0 0 14px 0; font-size: 12px; color: var(--color-ink-muted); line-height: 1.5;">
					MD5 hash of unencrypted SSLVersion, Ciphers, Extensions, EllipticCurves, and ECPointFormats.
				</p>
				<div style="background: #0f172a; padding: 12px 14px; border-radius: var(--radius-sm); border: 1px solid #1e293b; margin-bottom: 14px;">
					<code id="ja3-hash" style="font-family: var(--font-mono); font-size: 14px; font-weight: 700; color: #a78bfa; word-break: break-all;">0149f47eabf9a20d0893e2a44e5a6323</code>
				</div>
				<div style="font-size: 12px; color: var(--color-ink-muted); line-height: 1.5;">
					<strong>Note:</strong> In modern Chromium, extension permutation changes on each tab, which causes the legacy JA3 hash to alternate between 2-4 variants while JA4 remains stable.
				</div>
			</div>

			<!-- Card 3: Akamai HTTP/2 Fingerprint -->
			<div class="card" style="padding: 24px; border: 1px solid var(--color-border); background: var(--color-surface); border-radius: var(--radius-md);">
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
					<span class="badge badge-primary" style="font-size: 11px; font-weight: 700;">HTTP/2 Frame Analysis</span>
					<button type="button" class="btn-copy-sm" data-target="h2-hash" style="background: none; border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: 4px 10px; font-size: 11px; cursor: pointer; color: var(--color-ink);">Copy H2 Hash</button>
				</div>
				<h3 style="margin: 0 0 8px 0; font-size: 18px; font-weight: 800; color: var(--color-ink);">Akamai HTTP/2 Signature</h3>
				<p style="margin: 0 0 14px 0; font-size: 12px; color: var(--color-ink-muted); line-height: 1.5;">
					Hashes SETTINGS frame values, WINDOW_UPDATE increments, and pseudo-header sequence (:method, :authority, :scheme, :path).
				</p>
				<div style="background: #0f172a; padding: 12px 14px; border-radius: var(--radius-sm); border: 1px solid #1e293b; margin-bottom: 14px;">
					<code id="h2-hash" style="font-family: var(--font-mono); font-size: 14px; font-weight: 700; color: #34d399; word-break: break-all;">64a832f547be33249bf4d33e8a46c5dc</code>
				</div>
				<div style="background: var(--color-canvas-subtle); padding: 8px 12px; border-radius: var(--radius-sm); font-size: 11px; font-family: var(--font-mono); color: var(--color-ink-secondary); overflow-x: auto;">
					<span id="h2-raw">1:65536,2:0,3:1000,4:6291456,6:262144|15663105|0|m,a,s,p</span>
				</div>
			</div>

			<!-- Card 4: TLS Protocol & Handshake Specifications -->
			<div class="card" style="padding: 24px; border: 1px solid var(--color-border); background: var(--color-surface); border-radius: var(--radius-md);">
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
					<span class="badge" style="background: var(--color-canvas-muted); color: var(--color-ink); font-size: 11px; font-weight: 700;">Negotiated Transport</span>
					<span id="tls-badge" class="badge" style="background: #ecfdf5; color: #059669; font-weight: 800;">TLS 1.3</span>
				</div>
				<h3 style="margin: 0 0 8px 0; font-size: 18px; font-weight: 800; color: var(--color-ink);">Protocol &amp; ALPN State</h3>
				<ul style="list-style: none; padding: 0; margin: 0 0 16px 0; font-size: 13px; line-height: 2;">
					<li style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--color-border); padding: 4px 0;">
						<span style="color: var(--color-ink-muted);">Negotiated Version:</span>
						<strong id="spec-tls-ver">TLS 1.3 (RFC 8446)</strong>
					</li>
					<li style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--color-border); padding: 4px 0;">
						<span style="color: var(--color-ink-muted);">Record Layer Version:</span>
						<strong id="spec-record-ver">TLS 1.0 (Compatibility)</strong>
					</li>
					<li style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--color-border); padding: 4px 0;">
						<span style="color: var(--color-ink-muted);">ALPN Protocol:</span>
						<strong id="spec-alpn">h2 (HTTP/2)</strong>
					</li>
					<li style="display: flex; justify-content: space-between; padding: 4px 0;">
						<span style="color: var(--color-ink-muted);">GREASE Values:</span>
						<strong id="spec-grease" style="color: #059669;">Detected (Active Anti-Ossification)</strong>
					</li>
				</ul>
			</div>
		</div>

		<!-- Deep Diagnostic Tabs: Ciphers, Extensions, HTTP/2 Frames -->
		<div class="card" style="padding: 28px; margin-bottom: 40px; border: 1px solid var(--color-border); background: var(--color-surface); border-radius: var(--radius-lg);">
			<h2 style="font-size: 20px; font-weight: 800; margin: 0 0 16px 0; color: var(--color-ink);">
				Detailed Cryptographic Parameters
			</h2>

			<!-- Tabs Navigation -->
			<div style="display: flex; gap: 8px; border-bottom: 1px solid var(--color-border); margin-bottom: 20px; flex-wrap: wrap;">
				<button type="button" class="diag-tab active" data-tab="tab-ciphers" style="padding: 10px 18px; font-weight: 700; font-size: 14px; border: none; background: none; cursor: pointer; border-bottom: 2px solid var(--color-primary); color: var(--color-primary);">
					Supported Cipher Suites (<span id="ciphers-count">31</span>)
				</button>
				<button type="button" class="diag-tab" data-tab="tab-extensions" style="padding: 10px 18px; font-weight: 700; font-size: 14px; border: none; background: none; cursor: pointer; color: var(--color-ink-muted);">
					TLS Extensions (<span id="extensions-count">12</span>)
				</button>
				<button type="button" class="diag-tab" data-tab="tab-h2" style="padding: 10px 18px; font-weight: 700; font-size: 14px; border: none; background: none; cursor: pointer; color: var(--color-ink-muted);">
					HTTP/2 Settings &amp; Frames
				</button>
				<button type="button" class="diag-tab" data-tab="tab-network" style="padding: 10px 18px; font-weight: 700; font-size: 14px; border: none; background: none; cursor: pointer; color: var(--color-ink-muted);">
					Network &amp; Headers
				</button>
			</div>

			<!-- Tab 1: Ciphers -->
			<div id="tab-ciphers" class="diag-panel">
				<p style="font-size: 13px; color: var(--color-ink-muted); margin-bottom: 14px;">
					The exact sequence of cipher suites offered by your browser in the ClientHello packet. Anti-bot heuristics flag clients when this sequence does not match the standard Chromium / Firefox ordering.
				</p>
				<div style="max-height: 380px; overflow-y: auto; border: 1px solid var(--color-border); border-radius: var(--radius-sm);">
					<table style="width: 100%; border-collapse: collapse; font-size: 13px; text-align: left;">
						<thead style="background: var(--color-canvas-subtle); border-bottom: 1px solid var(--color-border);">
							<tr>
								<th style="padding: 10px 14px; font-weight: 700; width: 60px;">#</th>
								<th style="padding: 10px 14px; font-weight: 700;">Cipher Suite Name (RFC)</th>
								<th style="padding: 10px 14px; font-weight: 700; width: 140px;">Standard</th>
							</tr>
						</thead>
						<tbody id="ciphers-tbody">
							<tr>
								<td colspan="3" style="padding: 20px; text-align: center; color: var(--color-ink-muted);">Loading cipher suites...</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>

			<!-- Tab 2: Extensions -->
			<div id="tab-extensions" class="diag-panel" style="display: none;">
				<p style="font-size: 13px; color: var(--color-ink-muted); margin-bottom: 14px;">
					TLS extensions announced during connection setup. Modern browsers include Encrypted Client Hello (ECH), post-quantum Kyber key encapsulation, and GREASE extensions.
				</p>
				<div style="max-height: 380px; overflow-y: auto; border: 1px solid var(--color-border); border-radius: var(--radius-sm);">
					<table style="width: 100%; border-collapse: collapse; font-size: 13px; text-align: left;">
						<thead style="background: var(--color-canvas-subtle); border-bottom: 1px solid var(--color-border);">
							<tr>
								<th style="padding: 10px 14px; font-weight: 700; width: 60px;">#</th>
								<th style="padding: 10px 14px; font-weight: 700;">Extension Name</th>
								<th style="padding: 10px 14px; font-weight: 700; width: 120px;">Category</th>
							</tr>
						</thead>
						<tbody id="extensions-tbody">
							<tr>
								<td colspan="3" style="padding: 20px; text-align: center; color: var(--color-ink-muted);">Loading extensions...</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>

			<!-- Tab 3: HTTP/2 -->
			<div id="tab-h2" class="diag-panel" style="display: none;">
				<p style="font-size: 13px; color: var(--color-ink-muted); margin-bottom: 14px;">
					HTTP/2 frames exchanged during initial handshake. Automated scrapers using Node.js or Python often fail to emulate window size updates and pseudo-header ordering.
				</p>
				<div style="background: #0f172a; padding: 16px; border-radius: var(--radius-sm); font-family: var(--font-mono); font-size: 12px; color: #e2e8f0; overflow-x: auto;">
					<pre id="h2-frames-raw" style="margin: 0; line-height: 1.6;">Loading HTTP/2 frames...</pre>
				</div>
			</div>

			<!-- Tab 4: Network -->
			<div id="tab-network" class="diag-panel" style="display: none;">
				<p style="font-size: 13px; color: var(--color-ink-muted); margin-bottom: 14px;">
					Observed TCP/IP and HTTP layer metadata:
				</p>
				<ul style="list-style: none; padding: 0; margin: 0; font-size: 13px; line-height: 2;">
					<li style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--color-border); padding: 6px 0;">
						<span style="color: var(--color-ink-muted);">Remote IP Address:</span>
						<strong id="net-ip">Detecting...</strong>
					</li>
					<li style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--color-border); padding: 6px 0;">
						<span style="color: var(--color-ink-muted);">Client User-Agent:</span>
						<span id="net-ua" style="font-family: var(--font-mono); font-size: 12px; max-width: 600px; text-align: right; word-break: break-all;">Detecting...</span>
					</li>
					<li style="display: flex; justify-content: space-between; padding: 6px 0;">
						<span style="color: var(--color-ink-muted);">HTTP Protocol:</span>
						<strong id="net-proto">h2</strong>
					</li>
				</ul>
			</div>
		</div>

		<!-- Bot vs Browser Detection Comparison Matrix -->
		<div class="card" style="padding: 32px; margin-bottom: 40px; border: 1px solid var(--color-border); background: var(--color-surface); border-radius: var(--radius-lg);">
			<h2 style="font-size: 22px; font-weight: 800; margin: 0 0 12px 0; color: var(--color-ink);">
				Why Standard Web Scrapers Get Blocked by TLS Fingerprinting
			</h2>
			<p style="font-size: 14px; color: var(--color-ink-muted); line-height: 1.6; margin: 0 0 24px 0;">
				When scraping modern websites protected by Cloudflare, DataDome, or Akamai, changing your <code>User-Agent</code> header is not enough. Anti-bot engines inspect the TLS ClientHello packet at the transport layer before any HTTP request headers are inspected:
			</p>

			<div style="overflow-x: auto;">
				<table style="width: 100%; border-collapse: collapse; font-size: 13px; text-align: left;">
					<thead style="background: var(--color-canvas-subtle); border-bottom: 2px solid var(--color-border);">
						<tr>
							<th style="padding: 12px 14px; font-weight: 800;">Client Stack</th>
							<th style="padding: 12px 14px; font-weight: 800;">TLS Engine</th>
							<th style="padding: 12px 14px; font-weight: 800;">JA4 Signature</th>
							<th style="padding: 12px 14px; font-weight: 800;">GREASE &amp; ECH</th>
							<th style="padding: 12px 14px; font-weight: 800;">Anti-Bot Result</th>
						</tr>
					</thead>
