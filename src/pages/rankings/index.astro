---
import Base from "../../layouts/Base.astro";
import { fetchAllBrowsers, fetchAllMcpTools } from "../../utils/browser-data";

const { browsers } = await fetchAllBrowsers();
const { tools: mcpTools } = await fetchAllMcpTools();

const siteTitle = "2026 Cloud Browser & Browser MCP Leaderboards • BrowserReviews";
const siteDescription = "Official performance rankings and benchmark leaderboards for 60 Cloud Browsers and 32 Browser MCP tools evaluated by our independent testing lab.";
---

<Base title={siteTitle} description={siteDescription}>
  <div class="page-header">
    <div class="breadcrumb">
      <a href="/">Home</a> <span>/</span> <span>Rankings & Leaderboard</span>
    </div>
    <h1 class="page-title">2026 Cloud Browser & MCP Leaderboards</h1>
    <p class="page-subtitle">
      Independent performance rankings based on automated lab benchmarks measuring anti-bot bypass success, CAPTCHA solve latency, CDP handshake speed, and cost efficiency.
    </p>
  </div>

  <!-- Rankings Tabs Switcher -->
  <div class="rankings-tabs">
    <button class="tab-btn active" id="tabBrowsers">Top Cloud Browsers (60)</button>
    <button class="tab-btn" id="tabMcp">Top Browser MCP Tools (32)</button>
  </div>

  <!-- Table 1: Cloud Browsers Leaderboard -->
  <div id="sectionBrowsers" class="table-section">
    <div class="table-responsive">
      <table class="rankings-table">
        <thead>
          <tr>
            <th style="width: 70px;">Rank</th>
            <th>Cloud Browser</th>
            <th>Anti-Bot & CAPTCHA</th>
            <th>Protocols</th>
            <th>Price / Hour</th>
            <th>Lab Score</th>
            <th>Verdict</th>
          </tr>
        </thead>
        <tbody>
          {browsers.map((b) => (
            <tr class={b.demo_rank === 1 ? "row-gold" : b.demo_rank <= 3 ? "row-top3" : ""}>
              <td>
                <span class={`rank-badge rank-${b.demo_rank}`}>#{b.demo_rank}</span>
              </td>
              <td>
                <div class="provider-cell">
                  <a href={`/reviews/${b.slug}`} class="provider-name">{b.name}</a>
                  {b.status_badge && <span class="badge-mini">{b.status_badge}</span>}
                  <p class="provider-tagline">{b.tagline}</p>
                </div>
              </td>
              <td>
                <div class="spec-stack">
                  <span class={`status-tag ${b.captcha_auto_solve.includes("Native") ? "tag-green" : "tag-gray"}`}>
                    {b.captcha_auto_solve.includes("Native") ? "✔ Native Auto CAPTCHA" : "External Solver"}
                  </span>
                  <span class="status-sub">{b.antibot_bypass.slice(0, 35)}...</span>
                </div>
              </td>
              <td>
                <div class="protocol-tags">
                  {b.cdp_support && <span class="p-tag">CDP</span>}
                  {b.playwright_support && <span class="p-tag">Playwright</span>}
                  {b.puppeteer_support && <span class="p-tag">Puppeteer</span>}
                </div>
              </td>
              <td>
                <div class="price-hour">${b.starting_price_hour.toFixed(2)} / hr</div>
                <div class="price-model">{b.pricing_model.replace(/_/g, " ")}</div>
              </td>
              <td>
                <span class="score-pill">★ {b.overall_score.toFixed(1)}</span>
              </td>
              <td>
                <a href={`/reviews/${b.slug}`} class="btn-review">Review →</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Table 2: Browser MCP Tools Leaderboard -->
  <div id="sectionMcp" class="table-section" style="display: none;">
    <div class="table-responsive">
      <table class="rankings-table">
        <thead>
          <tr>
            <th style="width: 70px;">Rank</th>
            <th>Browser MCP Tool</th>
            <th>Tools Exposed</th>
            <th>Compatibility</th>
            <th>CAPTCHA Handling</th>
            <th>Score</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          {mcpTools.map((m) => (
            <tr class={m.demo_rank === 1 ? "row-purple" : ""}>
              <td>
                <span class={`rank-badge rank-${m.demo_rank}`}>#{m.demo_rank}</span>
              </td>
              <td>
                <div class="provider-cell">
                  <a href={`/mcp/${m.slug}`} class="provider-name">{m.name}</a>
                  {m.status_badge && <span class="badge-mini">{m.status_badge}</span>}
                  <p class="provider-tagline">{m.tagline}</p>
                </div>
              </td>
              <td>
                <span class="tools-count">{m.tools_provided.length} Tools</span>
              </td>
              <td>
                <div class="protocol-tags">
                  {m.supports_claude_desktop && <span class="p-tag">Claude</span>}
                  {m.supports_cursor && <span class="p-tag">Cursor</span>}
                  {m.github_url && <span class="p-tag">GitHub</span>}
                </div>
              </td>
              <td>
                <span class={`status-tag ${m.captcha_solving.includes("Native") ? "tag-green" : "tag-gray"}`}>
                  {m.captcha_solving.includes("Native") ? "✔ Native 2Captcha" : "External / Vision"}
                </span>
              </td>
              <td>
                <span class="score-pill">★ {m.overall_score.toFixed(1)}</span>
              </td>
              <td>
                <a href={`/mcp/${m.slug}`} class="btn-review">Guide →</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</Base>

<script>
  const tabBrowsers = document.getElementById('tabBrowsers');
  const tabMcp = document.getElementById('tabMcp');
  const sectionBrowsers = document.getElementById('sectionBrowsers');
  const sectionMcp = document.getElementById('sectionMcp');

  tabBrowsers?.addEventListener('click', () => {
    tabBrowsers.classList.add('active');
    tabMcp?.classList.remove('active');
    if (sectionBrowsers) sectionBrowsers.style.display = 'block';
    if (sectionMcp) sectionMcp.style.display = 'none';
  });

  tabMcp?.addEventListener('click', () => {
    tabMcp.classList.add('active');
    tabBrowsers?.classList.remove('active');
    if (sectionMcp) sectionMcp.style.display = 'block';
    if (sectionBrowsers) sectionBrowsers.style.display = 'none';
  });
</script>

<style>
  .page-header {
    padding: 2.5rem 0 1.5rem;
  }
  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }
  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .breadcrumb span {
    margin: 0 0.35rem;
  }
  .page-title {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 800;
    margin-bottom: 0.75rem;
  }
  .page-subtitle {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    max-width: 800px;
    line-height: 1.5;
  }

  .rankings-tabs {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.75rem;
  }
  .tab-btn {
    padding: 0.65rem 1.25rem;
    font-size: 0.95rem;
    font-weight: 700;
    border: none;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    border-radius: 8px;
    transition: all 0.2s ease;
  }
  .tab-btn:hover {
    color: var(--color-text);
    background: var(--color-bg-secondary, #f8fafc);
  }
  .tab-btn.active {
    background: var(--color-primary);
    color: #ffffff;
  }

  .table-section {
    margin-bottom: 4rem;
  }
  .table-responsive {
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-card-bg, #ffffff);
  }
  .rankings-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.92rem;
  }
  .rankings-table th {
    padding: 1rem 1.25rem;
    background: var(--color-bg-secondary, #f8fafc);
    border-bottom: 1px solid var(--color-border);
    font-weight: 600;
    font-size: 0.8rem;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .rankings-table td {
    padding: 1.1rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
    vertical-align: middle;
  }
  .row-gold {
    background: rgba(245, 158, 11, 0.06);
  }
  .row-purple {
    background: rgba(139, 92, 246, 0.06);
  }
  .row-top3 {
    background: rgba(59, 130, 246, 0.02);
  }

  .rank-badge {
    display: inline-block;
    padding: 0.25rem 0.5rem;
    font-size: 0.8rem;
    font-weight: 700;
    border-radius: 4px;
    background: #e2e8f0;
    color: #334155;
  }
  .rank-1 {
    background: #fef3c7;
    color: #92400e;
  }
  .rank-2 {
    background: #e0e7ff;
    color: #4338ca;
  }
  .rank-3 {
    background: #f1f5f9;
    color: #0f172a;
  }

  .provider-cell {
    max-width: 380px;
  }
  .provider-name {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-text);
    text-decoration: none;
  }
  .provider-name:hover {
    color: var(--color-primary);
  }
  .badge-mini {
    display: inline-block;
    padding: 0.15rem 0.45rem;
    font-size: 0.72rem;
    font-weight: 600;
    border-radius: 4px;
    background: #dbeafe;
    color: #1e40af;
    margin-left: 0.5rem;
  }
  .provider-tagline {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin: 0.25rem 0 0;
    line-height: 1.4;
  }

  .spec-stack {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .status-tag {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    width: fit-content;
  }
  .tag-green {
    background: #d1fae5;
    color: #065f46;
  }
  .tag-gray {
    background: #f1f5f9;
    color: #475569;
  }
  .status-sub {
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .protocol-tags {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }
  .p-tag {
    font-size: 0.72rem;
    background: #f1f5f9;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    color: #334155;
    font-weight: 500;
  }

  .price-hour {
    font-weight: 700;
    font-size: 0.95rem;
  }
  .price-model {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-transform: capitalize;
  }

  .score-pill {
    font-weight: 700;
    color: #059669;
    font-size: 0.95rem;
  }

  .tools-count {
    font-weight: 600;
    color: #8b5cf6;
    font-size: 0.9rem;
  }

  .btn-review {
    padding: 0.4rem 0.85rem;
    font-size: 0.82rem;
    font-weight: 600;
    background: var(--color-bg-secondary, #f8fafc);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    text-decoration: none;
    color: var(--color-text);
    white-space: nowrap;
  }
  .btn-review:hover {
    background: var(--color-primary);
    color: #ffffff;
    border-color: var(--color-primary);
  }
</style>
