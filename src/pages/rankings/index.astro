---
import Base from "../../layouts/Base.astro";
import { fetchAllBrowsers, fetchAllMcpTools } from "../../utils/browser-data";

const { browsers } = await fetchAllBrowsers();
const { tools: mcpTools } = await fetchAllMcpTools();

const siteTitle = "2026 Cloud Browser & Browser MCP Leaderboards • BrowserReviews";
const siteDescription = "Official performance rankings and benchmark leaderboards for 60 Cloud Browsers and 32 Browser MCP tools evaluated by our independent testing lab.";
---

<Base title={siteTitle} description={siteDescription}>
  <div class="container rankings-container">
    <div class="page-header">
      <div class="breadcrumb">
        <a href="/">Home</a> <span>/</span> <span>Rankings &amp; Leaderboard</span>
      </div>
      <h1 class="page-title">2026 Cloud Browser &amp; MCP Leaderboards</h1>
      <p class="page-subtitle">
        Independent performance rankings based on automated lab benchmarks measuring anti-bot bypass success, CAPTCHA solve latency, CDP handshake speed, and compute cost efficiency.
      </p>
    </div>

    <!-- Rankings Tabs Switcher -->
    <div class="rankings-tabs-wrap">
      <div class="rankings-tabs">
        <button class="tab-btn active" id="tabBrowsers">
          <span class="tab-icon">⚡</span> Top Cloud Browsers <span class="tab-count">(60)</span>
        </button>
        <button class="tab-btn" id="tabMcp">
          <span class="tab-icon">🤖</span> Top Browser MCP Tools <span class="tab-count">(32)</span>
        </button>
      </div>
      <div class="table-scroll-hint">
        <span>⇄ Scroll table horizontally</span>
      </div>
    </div>

    <!-- Table 1: Cloud Browsers Leaderboard -->
    <div id="sectionBrowsers" class="table-section">
      <div class="table-responsive">
        <table class="rankings-table">
          <thead>
            <tr>
              <th class="col-rank">Rank</th>
              <th class="col-provider">Cloud Browser</th>
              <th class="col-antibot">Anti-Bot &amp; CAPTCHA</th>
              <th class="col-protocols">Protocols</th>
              <th class="col-pricing">Price / Hour</th>
              <th class="col-score">Lab Score</th>
              <th class="col-action">Verdict</th>
            </tr>
          </thead>
          <tbody>
            {browsers.map((b) => (
              <tr class={b.demo_rank === 1 ? "row-gold" : b.demo_rank <= 3 ? "row-top3" : ""}>
                <td class="col-rank">
                  <span class={`rank-badge rank-${b.demo_rank}`}>#{b.demo_rank}</span>
                </td>
                <td class="col-provider">
                  <div class="provider-cell">
                    <div class="provider-title-row">
                      <a href={`/reviews/${b.slug}`} class="provider-name">{b.name}</a>
                      {b.status_badge && <span class="badge-mini">{b.status_badge}</span>}
                    </div>
                    <p class="provider-tagline">{b.tagline}</p>
                  </div>
                </td>
                <td class="col-antibot">
                  <div class="spec-stack">
                    <span class={`status-tag ${b.captcha_auto_solve.includes("Native") ? "tag-green" : "tag-gray"}`}>
                      {b.captcha_auto_solve.includes("Native") ? "✔ Native Auto CAPTCHA" : "External Solver"}
                    </span>
                    <span class="status-sub">{b.antibot_bypass.slice(0, 36)}...</span>
                  </div>
                </td>
                <td class="col-protocols">
                  <div class="protocol-tags">
                    {b.cdp_support && <span class="p-tag">CDP</span>}
                    {b.playwright_support && <span class="p-tag">Playwright</span>}
                    {b.puppeteer_support && <span class="p-tag">Puppeteer</span>}
                  </div>
                </td>
                <td class="col-pricing">
                  <div class="price-hour">${b.starting_price_hour.toFixed(2)} <span class="unit">/ hr</span></div>
                  <div class="price-model">{b.pricing_model.replace(/_/g, " ")}</div>
                </td>
                <td class="col-score">
                  <span class="score-pill">★ {b.overall_score.toFixed(1)}</span>
                </td>
                <td class="col-action">
                  <a href={`/reviews/${b.slug}`} class="btn-review">Review →</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Table 2: Browser MCP Tools Leaderboard -->
    <div id="sectionMcp" class="table-section" style="display: none;">
      <div class="table-responsive">
        <table class="rankings-table">
          <thead>
            <tr>
              <th class="col-rank">Rank</th>
              <th class="col-provider">Browser MCP Tool</th>
              <th class="col-antibot">Tools Exposed</th>
              <th class="col-protocols">Compatibility</th>
              <th class="col-pricing">CAPTCHA Handling</th>
              <th class="col-score">Score</th>
              <th class="col-action">Action</th>
            </tr>
          </thead>
          <tbody>
            {mcpTools.map((m) => (
              <tr class={m.demo_rank === 1 ? "row-purple" : ""}>
                <td class="col-rank">
                  <span class={`rank-badge rank-${m.demo_rank}`}>#{m.demo_rank}</span>
                </td>
                <td class="col-provider">
                  <div class="provider-cell">
                    <div class="provider-title-row">
                      <a href={`/mcp/${m.slug}`} class="provider-name">{m.name}</a>
                      {m.status_badge && <span class="badge-mini badge-purple">{m.status_badge}</span>}
                    </div>
                    <p class="provider-tagline">{m.tagline}</p>
                  </div>
                </td>
                <td class="col-antibot">
                  <span class="tools-count">{m.tools_provided.length} Native Tools</span>
                  <div class="status-sub">navigate, click, type, screenshot</div>
                </td>
                <td class="col-protocols">
                  <div class="protocol-tags">
                    {m.supports_claude_desktop && <span class="p-tag">Claude</span>}
                    {m.supports_cursor && <span class="p-tag">Cursor</span>}
                    {m.github_url && <span class="p-tag">GitHub</span>}
                  </div>
                </td>
                <td class="col-pricing">
                  <span class={`status-tag ${m.captcha_solving.includes("Native") ? "tag-green" : "tag-gray"}`}>
                    {m.captcha_solving.includes("Native") ? "✔ Native 2Captcha" : "External / Vision"}
                  </span>
                </td>
                <td class="col-score">
                  <span class="score-pill">★ {m.overall_score.toFixed(1)}</span>
                </td>
                <td class="col-action">
                  <a href={`/mcp/${m.slug}`} class="btn-review">Guide →</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</Base>

<script>
  const tabBrowsers = document.getElementById('tabBrowsers');
  const tabMcp = document.getElementById('tabMcp');
  const sectionBrowsers = document.getElementById('sectionBrowsers');
  const sectionMcp = document.getElementById('sectionMcp');

  tabBrowsers?.addEventListener('click', () => {
    tabBrowsers.classList.add('active');
    tabMcp?.classList.remove('active');
    if (sectionBrowsers) sectionBrowsers.style.display = 'block';
    if (sectionMcp) sectionMcp.style.display = 'none';
  });

  tabMcp?.addEventListener('click', () => {
    tabMcp.classList.add('active');
    tabBrowsers?.classList.remove('active');
    if (sectionMcp) sectionMcp.style.display = 'block';
    if (sectionBrowsers) sectionBrowsers.style.display = 'none';
  });
</script>

<style>
  .rankings-container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 2rem 1.25rem 5rem;
  }

  .page-header {
    padding: 1.5rem 0 2rem;
  }
  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-ink-muted, #71717a);
    margin-bottom: 0.75rem;
  }
  .breadcrumb a {
    color: var(--color-ink-muted, #71717a);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .breadcrumb a:hover {
    color: var(--color-primary, #f59e0b);
  }
  .breadcrumb span {
    margin: 0 0.35rem;
  }
  .page-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 800;
    margin-bottom: 0.75rem;
    letter-spacing: -0.025em;
    color: var(--color-ink, #f4f4f5);
  }
  .page-subtitle {
    font-size: 1.05rem;
    color: var(--color-ink-secondary, #a1a1aa);
    max-width: 820px;
    line-height: 1.6;
    margin: 0;
  }

  .rankings-tabs-wrap {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.75rem;
    border-bottom: 1px solid var(--color-border, #222226);
    padding-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .rankings-tabs {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.25rem;
    font-size: 0.95rem;
    font-weight: 600;
    border: 1px solid var(--color-border, #222226);
    background: var(--color-surface, #131316);
    color: var(--color-ink-secondary, #a1a1aa);
    cursor: pointer;
    border-radius: 8px;
    transition: all 0.2s ease;
  }
  .tab-btn:hover {
    color: var(--color-ink, #f4f4f5);
    border-color: var(--color-border-strong, #333338);
    background: var(--color-surface-hover, #1c1c20);
  }
  .tab-btn.active {
    background: var(--color-primary, #f59e0b);
    color: #09090b;
    border-color: var(--color-primary, #f59e0b);
    font-weight: 700;
  }
  .tab-count {
    opacity: 0.8;
    font-size: 0.85rem;
  }

  .table-scroll-hint {
    font-size: 0.8rem;
    color: var(--color-ink-muted, #71717a);
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .table-section {
    margin-bottom: 4rem;
  }
  .table-responsive {
    overflow-x: auto;
    border: 1px solid var(--color-border, #222226);
    border-radius: 12px;
    background: var(--color-surface, #131316);
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.4);
    scrollbar-width: thin;
    scrollbar-color: var(--color-border-strong, #333338) transparent;
  }
  .table-responsive::-webkit-scrollbar {
    height: 8px;
  }
  .table-responsive::-webkit-scrollbar-track {
    background: transparent;
  }
  .table-responsive::-webkit-scrollbar-thumb {
    background: var(--color-border-strong, #333338);
    border-radius: 4px;
  }

  .rankings-table {
    width: 100%;
    min-width: 1040px;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.92rem;
  }
  .rankings-table th {
    padding: 1rem 1.25rem;
    background: var(--color-canvas-subtle, #111114);
    border-bottom: 1px solid var(--color-border, #222226);
    font-weight: 600;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-ink-muted, #71717a);
    white-space: nowrap;
  }
  .rankings-table td {
    padding: 1.15rem 1.25rem;
    border-bottom: 1px solid var(--color-border, #222226);
    vertical-align: middle;
  }
  .rankings-table tbody tr {
    transition: background-color 0.15s ease;
  }
  .rankings-table tbody tr:hover {
    background-color: var(--color-surface-hover, #1a1a1f);
  }

  /* Specific column widths */
  .col-rank {
    width: 75px;
    text-align: center;
  }
  .col-provider {
    width: 320px;
  }
  .col-antibot {
    width: 250px;
  }
  .col-protocols {
    width: 160px;
  }
  .col-pricing {
    width: 140px;
  }
  .col-score {
    width: 95px;
    text-align: center;
  }
  .col-action {
    width: 100px;
    text-align: right;
  }

  /* Special Row Accents */
  .row-gold {
    background: rgba(245, 158, 11, 0.06);
    border-left: 3px solid #f59e0b;
  }
  .row-purple {
    background: rgba(139, 92, 246, 0.06);
    border-left: 3px solid #8b5cf6;
  }
  .row-top3 {
    background: rgba(59, 130, 246, 0.02);
  }

  .rank-badge {
    display: inline-block;
    padding: 0.25rem 0.55rem;
    font-size: 0.8rem;
    font-weight: 700;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.06);
    color: var(--color-ink-secondary, #a1a1aa);
    border: 1px solid var(--color-border, #222226);
  }
  .rank-1 {
    background: rgba(245, 158, 11, 0.18);
    color: #fbbf24;
    border-color: rgba(245, 158, 11, 0.4);
  }
  .rank-2 {
    background: rgba(161, 161, 170, 0.15);
    color: #f4f4f5;
    border-color: rgba(161, 161, 170, 0.3);
  }
  .rank-3 {
    background: rgba(205, 127, 50, 0.15);
    color: #fdba74;
    border-color: rgba(205, 127, 50, 0.3);
  }

  .provider-cell {
    max-width: 320px;
  }
  .provider-title-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .provider-name {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-ink, #f4f4f5);
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .provider-name:hover {
    color: var(--color-primary, #f59e0b);
  }
  .badge-mini {
    display: inline-block;
    padding: 0.15rem 0.45rem;
    font-size: 0.72rem;
    font-weight: 600;
    border-radius: 4px;
    background: rgba(245, 158, 11, 0.15);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }
  .badge-purple {
    background: rgba(139, 92, 246, 0.15);
    color: #c084fc;
    border-color: rgba(139, 92, 246, 0.3);
  }
  .provider-tagline {
    font-size: 0.82rem;
    color: var(--color-ink-muted, #71717a);
    margin: 0.35rem 0 0;
    line-height: 1.4;
  }

  .spec-stack {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .status-tag {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    width: fit-content;
    white-space: nowrap;
  }
  .tag-green {
    background: rgba(16, 185, 129, 0.12);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.25);
  }
  .tag-gray {
    background: rgba(255, 255, 255, 0.05);
    color: var(--color-ink-secondary, #a1a1aa);
    border: 1px solid var(--color-border, #222226);
  }
  .status-sub {
    font-size: 0.78rem;
    color: var(--color-ink-muted, #71717a);
  }

  .protocol-tags {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }
  .p-tag {
    font-size: 0.72rem;
    background: rgba(255, 255, 255, 0.05);
    padding: 0.18rem 0.45rem;
    border-radius: 4px;
    color: var(--color-ink-secondary, #a1a1aa);
    font-weight: 500;
    border: 1px solid var(--color-border, #222226);
  }

  .price-hour {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-ink, #f4f4f5);
  }
  .price-hour .unit {
    font-size: 0.78rem;
    font-weight: 400;
    color: var(--color-ink-muted, #71717a);
  }
  .price-model {
    font-size: 0.75rem;
    color: var(--color-ink-muted, #71717a);
    text-transform: capitalize;
    margin-top: 0.2rem;
  }

  .score-pill {
    display: inline-block;
    font-weight: 700;
    color: #34d399;
    font-size: 0.95rem;
    background: rgba(16, 185, 129, 0.08);
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    border: 1px solid rgba(16, 185, 129, 0.2);
    white-space: nowrap;
  }

  .tools-count {
    font-weight: 600;
    color: #c084fc;
    font-size: 0.88rem;
  }

  .btn-review {
    display: inline-block;
    padding: 0.45rem 0.9rem;
    font-size: 0.82rem;
    font-weight: 600;
    background: var(--color-surface, #131316);
    border: 1px solid var(--color-border, #222226);
    border-radius: 6px;
    text-decoration: none;
    color: var(--color-ink, #f4f4f5);
    white-space: nowrap;
    transition: all 0.15s ease;
  }
  .btn-review:hover {
    background: var(--color-primary, #f59e0b);
    color: #09090b;
    border-color: var(--color-primary, #f59e0b);
  }

  @media (max-width: 768px) {
    .rankings-container {
      padding: 1.5rem 1rem 3rem;
    }
    .page-title {
      font-size: 1.75rem;
    }
    .page-subtitle {
      font-size: 0.95rem;
    }
    .rankings-tabs {
      width: 100%;
    }
    .tab-btn {
      flex: 1;
      justify-content: center;
      padding: 0.55rem 0.75rem;
      font-size: 0.85rem;
    }
  }
</style>
