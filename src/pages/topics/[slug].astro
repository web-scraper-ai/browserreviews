---
import Base from "../../layouts/Base.astro";
import { TOPIC_CLUSTERS } from "../../../scripts/data-topics.mjs";

const { slug } = Astro.params;
const topic = TOPIC_CLUSTERS.find((t) => t.slug === slug);

if (!topic) {
  return Astro.redirect("/topics");
}

const siteTitle = topic.metaTitle;
const siteDescription = topic.metaDesc;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": topic.h1,
  "description": topic.metaDesc,
  "articleSection": topic.badge,
  "keywords": topic.targetKeywords.join(", ")
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": topic.faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://browserreviews.com/" },
    { "@type": "ListItem", "position": 2, "name": "Topics", "item": "https://browserreviews.com/topics/" },
    { "@type": "ListItem", "position": 3, "name": topic.title, "item": `https://browserreviews.com/topics/${topic.slug}/` }
  ]
};
---

<Base title={siteTitle} description={siteDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <article class="topic-container">
    <div class="breadcrumb">
      <a href="/">Home</a> <span>/</span> <a href="/topics/">Topics</a> <span>/</span> <span>{topic.badge}</span>
    </div>

    <header class="topic-header">
      <div class="badge-tag">{topic.badge}</div>
      <h1 class="topic-h1">{topic.h1}</h1>
      <p class="topic-lead">{topic.summary}</p>
    </header>

    <div class="callout callout-gold">
      <div class="callout-badge">#1 Top Recommended Platform</div>
      <h3>{topic.topPickName}</h3>
      <p>{topic.topPickReason}</p>
      <div class="callout-actions">
        <a 
          href={topic.topPickSlug.includes("mcp") ? "/mcp/2captcha-browser-mcp/" : "/reviews/2captcha-browser-api/"} 
          class="btn btn-primary"
          data-provider={topic.topPickSlug}
          data-click-location="topic_callout_primary"
        >
          View #1 Ranked Review →
        </a>
        <a 
          href="https://2captcha.com" 
          target="_blank" 
          rel="noopener" 
          class="btn btn-outline"
          data-provider={topic.topPickSlug}
          data-click-location="topic_callout_outbound"
        >
          Get Free API Key on 2Captcha
        </a>
      </div>
    </div>

    <div class="kw-cluster-box">
      <strong>Target Queries in this Hub:</strong>
      <div class="kw-tags">
        {topic.targetKeywords.map((kw) => (
          <span class="kw-pill">{kw}</span>
        ))}
      </div>
    </div>

    <div class="topic-content">
      {topic.sections.map((sec) => (
        <section class="content-sec">
          <h2>{sec.heading}</h2>
          <p>{sec.content}</p>
        </section>
      ))}

      <h2>Comparison & Technical Benchmark</h2>
      <table class="spec-table">
        <thead>
          <tr>
            <th>Provider / Setup</th>
            <th>Pricing / Rate</th>
            <th>Protocol</th>
            <th>Turnstile Bypass</th>
            <th>Proxies</th>
            <th>Commitment</th>
          </tr>
        </thead>
        <tbody>
          {topic.tableData.map((row) => (
            <tr class={row.provider.includes("#1") ? "row-highlight" : ""}>
              <td><strong>{row.provider}</strong></td>
              <td>{row.rate}</td>
              <td>{row.protocol}</td>
              <td>{row.turnstile}</td>
              <td>{row.proxies}</td>
              <td>{row.minMonthly}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <h2>Frequently Asked Questions</h2>
      <div class="faq-list">
        {topic.faqs.map((f) => (
          <div class="faq-item">
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </div>

      <div class="next-step-box">
        <h3>Explore More Topics & Integration Guides</h3>
        <p>
          Need hands-on code examples for Puppeteer, Playwright, or Claude Desktop?
        </p>
        <div class="next-step-links">
          <a href="/guides" class="btn btn-outline">Developer Guides Hub</a>
          <a href="/rankings" class="btn btn-outline">All Browser Rankings</a>
          <a href="/what-is-a-headless-browser" class="btn btn-primary">What is a Headless Browser? →</a>
        </div>
      </div>
    </div>
  </article>
</Base>

<style>
  .topic-container {
    max-width: 820px;
    margin: 0 auto;
    padding: 1rem 0 3rem 0;
  }
  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-ink-muted);
    margin-bottom: 1.5rem;
    display: flex;
    gap: 0.5rem;
  }
  .breadcrumb a {
    color: var(--color-ink-muted);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--color-ink);
  }
  .topic-header {
    margin-bottom: 2rem;
  }
  .badge-tag {
    display: inline-block;
    background: rgba(245, 158, 11, 0.1);
    color: #f59e0b;
    border: 1px solid rgba(245, 158, 11, 0.3);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }
  .topic-h1 {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.3;
    margin: 0 0 1rem 0;
    letter-spacing: -0.02em;
  }
  .topic-lead {
    font-size: 1.15rem;
    color: var(--color-ink-muted);
    line-height: 1.6;
    margin: 0;
  }
  .callout-gold {
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.08) 0%, rgba(245, 158, 11, 0.02) 100%);
    border: 1px solid rgba(245, 158, 11, 0.3);
    border-radius: 12px;
    padding: 1.75rem;
    margin: 2rem 0;
  }
  .callout-badge {
    display: inline-block;
    background: #f59e0b;
    color: #000;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    margin-bottom: 0.75rem;
  }
  .callout-gold h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1.3rem;
  }
  .callout-gold p {
    color: var(--color-ink-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0 0 1.25rem 0;
  }
  .callout-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .kw-cluster-box {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1rem 1.25rem;
    margin-bottom: 2rem;
    font-size: 0.85rem;
  }
  .kw-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.5rem;
  }
  .kw-pill {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--color-border);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-family: monospace;
    font-size: 0.8rem;
    color: var(--color-primary);
  }
  .topic-content h2 {
    font-size: 1.6rem;
    font-weight: 800;
    margin: 2.5rem 0 1rem 0;
  }
  .topic-content p {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-ink-muted);
    margin-bottom: 1.25rem;
  }
  .spec-table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0 2rem 0;
    font-size: 0.9rem;
  }
  .spec-table th, .spec-table td {
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--color-border);
    text-align: left;
  }
  .spec-table th {
    background: var(--color-surface);
  }
  .row-highlight {
    background: rgba(245, 158, 11, 0.05);
    border-left: 3px solid #f59e0b;
  }
  .faq-list {
    margin-top: 1rem;
  }
  .faq-item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.25rem;
    margin-bottom: 1rem;
  }
  .faq-item h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1.1rem;
    color: var(--color-ink);
  }
  .faq-item p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-ink-muted);
    line-height: 1.6;
  }
  .next-step-box {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 2rem;
    margin-top: 3rem;
  }
  .next-step-box h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1.3rem;
  }
  .next-step-box p {
    margin: 0 0 1.25rem 0;
    color: var(--color-ink-muted);
  }
  .next-step-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
