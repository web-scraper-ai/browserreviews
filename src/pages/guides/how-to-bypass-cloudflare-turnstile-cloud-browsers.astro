    </div>
  </article>
</Base>

<style>
  .article-container {
    max-width: 820px;
    margin: 0 auto;
    padding: 1rem 0 3rem 0;
  }
  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-ink-muted);
    margin-bottom: 1.5rem;
    display: flex;
    gap: 0.5rem;
  }
  .breadcrumb a {
    color: var(--color-ink-muted);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--color-ink);
  }
  .article-header {
    margin-bottom: 2rem;
  }
  .article-meta {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-bottom: 1rem;
  }
  .badge-tag {
    background: rgba(245, 158, 11, 0.1);
    color: #f59e0b;
    border: 1px solid rgba(245, 158, 11, 0.3);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    text-transform: uppercase;
  }
  .read-time {
    font-size: 0.85rem;
    color: var(--color-ink-muted);
  }
  .article-title {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.3;
    margin: 0 0 1rem 0;
    letter-spacing: -0.02em;
  }
  .article-lead {
    font-size: 1.15rem;
    color: var(--color-ink-muted);
    line-height: 1.6;
    margin: 0;
  }
  .callout-gold {
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.08) 0%, rgba(245, 158, 11, 0.02) 100%);
    border: 1px solid rgba(245, 158, 11, 0.3);
    border-radius: 12px;
    padding: 1.75rem;
    margin: 2rem 0;
  }
  .callout-badge {
    display: inline-block;
    background: #f59e0b;
    color: #000;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    margin-bottom: 0.75rem;
  }
  .callout-gold h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1.3rem;
  }
  .callout-gold p {
    color: var(--color-ink-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0 0 1.25rem 0;
  }
  .callout-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .article-content h2 {
    font-size: 1.6rem;
    font-weight: 800;
    margin: 2.5rem 0 1rem 0;
  }
  .article-content p, .article-content li {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-ink-muted);
  }
  .article-content ul, .article-content ol {
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .article-content li {
    margin-bottom: 0.5rem;
  }
  .code-container {
    background: #0d1117;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    margin: 1.5rem 0;
    overflow: hidden;
  }
  .code-header {
    background: #161b22;
    padding: 0.6rem 1rem;
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--color-ink-muted);
    font-family: monospace;
    border-bottom: 1px solid var(--color-border);
  }
  .code-lang {
    color: #f59e0b;
  }
  .code-block {
    background: #0d1117;
    color: #e6edf3;
    padding: 1.25rem;
    margin: 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.9rem;
    line-height: 1.5;
    overflow-x: auto;
  }
  .spec-table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0 2rem 0;
    font-size: 0.95rem;
  }
  .spec-table th, .spec-table td {
    padding: 0.8rem 1rem;
    border: 1px solid var(--color-border);
    text-align: left;
  }
  .spec-table th {
    background: var(--color-surface);
  }
  .next-step-box {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 2rem;
    margin-top: 3rem;
  }
  .next-step-box h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1.3rem;
  }
  .next-step-box p {
    margin: 0 0 1.25rem 0;
    color: var(--color-ink-muted);
  }
  .next-step-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
