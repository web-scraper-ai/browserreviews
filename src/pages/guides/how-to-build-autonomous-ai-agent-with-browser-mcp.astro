---
import Base from "../../layouts/Base.astro";

const siteTitle = "How to Build an Autonomous AI Browsing Agent with Browser MCP • BrowserReviews";
const siteDescription = "Developer guide to building autonomous web browsing agents in Python with Model Context Protocol (MCP) and 2Captcha Browser API. Bypass CAPTCHAs and extract clean data.";

const schemaMarkup = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": "How to Build an Autonomous AI Browsing Agent with Browser MCP",
  "description": "Architectural guide and complete Python script for building autonomous web browsing agents using Model Context Protocol (MCP) and cloud headless browsers with automated Turnstile bypass.",
  "author": {
    "@type": "Organization",
    "name": "BrowserReviews"
  },
  "datePublished": "2026-11-11T20:00:00Z",
  "dateModified": "2026-11-11T20:00:00Z"
};

const pythonSnippet = `import asyncio
import os
import json
from mcp import ClientSession, StdioServerParameters
from mcp.client.stdio import stdio_client

API_KEY = os.getenv("TWOCAPTCHA_API_KEY", "your_2captcha_api_key")

server_params = StdioServerParameters(
    command="npx",
    args=["-y", "@2captcha/browser-mcp"],
    env={"TWOCAPTCHA_API_KEY": API_KEY}
)

async def run_autonomous_agent():
    print("Initializing Autonomous AI Browsing Agent via MCP...")
    async with stdio_client(server_params) as (read, write):
        async with ClientSession(read, write) as session:
            await session.initialize()
            tools = await session.list_tools()
            print(f"Connected to Browser MCP! Available tools: {[t.name for t in tools.tools]}")

            # 1. Instruct browser to navigate to protected target
            target = "https://example.com/live-market-data"
            print(f"Agent navigating to: {target}")
            nav_result = await session.call_tool("browser_navigate", arguments={
                "url": target,
                "solve_captchas": True,
                "wait_until": "networkidle"
            })

            # 2. Extract DOM snapshot and text content
            snapshot = await session.call_tool("browser_snapshot", arguments={
                "extract_mode": "structured_text"
            })
            print("Extracted Page Context (Ready for LLM reasoning):")
            print(snapshot.content[0].text[:300] + "...")

            # 3. Autonomous agent clicks next action / pagination
            click_res = await session.call_tool("browser_click", arguments={
                "selector": "button.load-more-records"
            })
            print("Autonomous action executed successfully!")

if __name__ == "__main__":
    asyncio.run(run_autonomous_agent())`;
