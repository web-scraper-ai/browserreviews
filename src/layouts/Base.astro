---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import { toSiteUrl } from "../utils/site-url";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	imageWidth?: number | null;
	imageHeight?: number | null;
	imageType?: string | null;
	imageAlt?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, imageWidth, imageHeight, imageType, imageAlt, canonical, content } =
	Astro.props;
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const brandName = "BrowserReviews";
const fullTitle = title.includes(brandName) ? title : `${title} — ${brandName}`;
const pageDescription = description ?? "Independent cloud browser & scraping browser API directory, verified compute pricing comparisons, and AI agent Browser MCP teardowns.";
const canonicalUrl = toSiteUrl(canonical || Astro.url.pathname, Astro.url.origin);

const siteOrigin = toSiteUrl("", Astro.url.origin);
const isDefaultImage = !image;
const defaultSocialImage = toSiteUrl("/images/social-preview.png", siteOrigin);
const socialImage = image ? toSiteUrl(image, siteOrigin) : defaultSocialImage;
const socialImageWidth = isDefaultImage ? 1200 : (imageWidth ?? null);
const socialImageHeight = isDefaultImage ? 630 : (imageHeight ?? null);
const socialImageType = isDefaultImage
	? "image/png"
	: (imageType ?? (socialImage.endsWith(".png") ? "image/png" : socialImage.endsWith(".jpg") || socialImage.endsWith(".jpeg") ? "image/jpeg" : socialImage.endsWith(".webp") ? "image/webp" : null));
const socialImageAlt = imageAlt ?? (isDefaultImage ? "BrowserReviews — Cloud Browser & Browser MCP Reviews" : (pageTitle ?? title));

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical: canonicalUrl,
	image: socialImage,
	content,
	siteName: brandName,
	siteUrl: siteOrigin,
});
const organizationSchema = {
	"@context": "https://schema.org",
	"@type": "Organization",
	"name": "BrowserReviews",
	"url": siteOrigin,
	"description": "Cloud browser & scraping browser API review platform, verified hourly compute pricing comparisons, CDP specifications, and AI agent Browser MCP servers."
};

---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="robots" content="index, follow" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
